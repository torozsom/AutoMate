# Run Initialize-TelemetrySecrets.ps1 once, then copy the generated
# ../../.telemetry/pilot/compose.env to .env in this folder.
# Reuse existing pilot credentials when upgrading; do not rotate storage keys.
OBJECT_STORAGE_ACCESS_KEY=automate-pilot
OBJECT_STORAGE_SECRET_KEY=replace-with-the-generated-object-store-password
TELEMETRY_SECRETS_DIR=C:/Dev/AutoMate/.telemetry/pilot
TELEMETRY_INGEST_TOKEN=replace-with-the-generated-ingestion-token
TELEMETRY_PORT=9443
