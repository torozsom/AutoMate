AUTOMATE_PORT=8080

# Only this host directory is available for scanning/deployment, as /workspace.
PROJECTS_ROOT=C:/

# Must match ../infrastructure/.env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password

# Reuse the generated token in ../../.telemetry/pilot/compose.env (at least 32 characters).
TELEMETRY_INGEST_TOKEN=replace-with-the-generated-ingestion-token
# Existing spool/archive volume; keep this name when restarting the local stack.
TELEMETRY_SPOOL_VOLUME=automate-telemetry_telemetry-spool

# OAuth callbacks must use this installation's public URL.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID=organizations
