# Versioned image published by the AutoMate release pipeline.
AUTOMATE_IMAGE=ghcr.io/your-org/automate:latest
AUTOMATE_PORT=8080
PROJECTS_ROOT=C:/Dev

# Generate unique values before first start. Do not commit the resulting .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

# Private HTTPS endpoints; generate the ingestion credential and share it only with the Telemetry service.
TELEMETRY_GATEWAY_URL=https://telemetry.example.internal
TELEMETRY_INGEST_TOKEN=replace-with-at-least-32-random-characters
TELEMETRY_LOKI_URL=https://logs.example.internal
TELEMETRY_METRICS_WRITE_URL=https://metrics.example.internal/otlp/v1/metrics
TELEMETRY_METRICS_QUERY_URL=https://metrics.example.internal/prometheus
# Used when running the bundled development telemetry override on the same Compose network.
TELEMETRY_DATABASE_CONNECTION=Host=postgres;Database=automate;Username=automate;Password=replace-with-the-same-postgres-password

# Register OAuth applications using this installation's public URL.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID=organizations
