{
  "HostingProfile": {
    "Mode": "SelfHosted"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DeploymentDiagnostics": {
    "BufferCapacity": 512
  },
  "TelemetryStorage": {
    "Backend": "LokiMimir",
    "DeliveryMode": "DiskGateway"
  },
  "OpenTelemetry": {
    "ExportConsole": false
  }
}
