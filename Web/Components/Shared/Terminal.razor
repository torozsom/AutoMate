@inject IJSRuntime JSRuntime
@inject ILogger<Terminal> Logger
@implements IAsyncDisposable

<div id="@Id" style="height: 100%; width: 100%; padding: 10px;"></div>

@code {
    private const int MaxPendingCharacters = 2_250_000;
    private readonly Queue<string> _pendingWrites = new();
    private int _pendingCharacters;
    private bool _pendingOverflow;
    private bool _isReady;

    /// <summary>
    ///     Unique identifier for the terminal instance, used for JavaScript interop.
    /// </summary>
    [Parameter]
    public string Id { get; set; } = $"terminal-{Guid.NewGuid():N}";


    /// <summary>
    ///     Event callback that is invoked when the terminal instance is ready on the client side,
    ///     allowing parent components to perform actions once the terminal is initialized.
    /// </summary>
    [Parameter]
    public EventCallback OnReady { get; set; }


    /// <summary>
    ///     Initializes the xterm.js terminal instance on the client side after the component has rendered for the first time.
    /// </summary>
    /// <param name="firstRender">The first render indicator.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("xtermWrapper.init", Id);

            while (_pendingWrites.TryDequeue(out var pending))
            {
                _pendingCharacters -= pending.Length;
                await JSRuntime.InvokeVoidAsync("xtermWrapper.write", Id, pending);
            }

            _isReady = true;
            if (_pendingOverflow)
            {
                await JSRuntime.InvokeVoidAsync("xtermWrapper.write", Id,
                    "\r\n[Some output was omitted while the terminal initialized. Reload to recover available history.]\r\n");
                _pendingOverflow = false;
            }

            if (OnReady.HasDelegate)
                await OnReady.InvokeAsync();
        }
    }


    /// <summary>
    ///     Writes text to the terminal instance on the client side using JavaScript interop.
    /// </summary>
    /// <param name="text">The text to write.</param>
    public async Task WriteAsync(string text)
    {
        if (!_isReady)
        {
            if (_pendingCharacters + text.Length <= MaxPendingCharacters)
            {
                _pendingWrites.Enqueue(text);
                _pendingCharacters += text.Length;
            }
            else
            {
                _pendingOverflow = true;
            }

            return;
        }

        await JSRuntime.InvokeVoidAsync("xtermWrapper.write", Id, text);
    }

    public Task ClearAsync()
    {
        _pendingWrites.Clear();
        _pendingCharacters = 0;
        _pendingOverflow = false;
        if (!_isReady) return Task.CompletedTask;
        return JSRuntime.InvokeVoidAsync("xtermWrapper.clear", Id).AsTask();
    }


    /// <summary>
    ///     Writes a line of text to the terminal instance on the client side using JavaScript interop.
    /// </summary>
    /// <param name="text">The text to write.</param>
    public async Task WriteLineAsync(string text)
    {
        await WriteAsync(text + "\r\n");
    }


    /// <summary>
    ///     Disposes of the terminal instance on the client side when the
    ///     component is disposed, ensuring proper cleanup of resources.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("xtermWrapper.dispose", Id);
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "JS interop failed during disposal of terminal {TerminalId}.", Id);
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogDebug(ex, "Terminal disposal was cancelled for {TerminalId}.", Id);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "JS interop was unavailable during disposal of terminal {TerminalId}.", Id);
        }
    }

}
