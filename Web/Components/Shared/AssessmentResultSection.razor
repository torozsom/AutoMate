<h3 class="h6">@Title</h3>
@if (Items.Count == 0)
{
    <p>@EmptyMessage</p>
}
else
{
    <ul>@foreach (var item in Items)
        {
            <li class="text-break" style="white-space: pre-wrap">@item</li>
        }
    </ul>
}

@code {

    /// <summary>Authored section heading; Razor encodes all displayed prose.</summary>
    [Parameter]
    public string Title { get; set; } = "";

    /// <summary>Already validated and redacted bounded section items.</summary>
    [Parameter]
    public IReadOnlyList<string> Items { get; set; } = [];

    /// <summary>Fixed explanatory guidance when no observations support this section.</summary>
    [Parameter]
    public string EmptyMessage { get; set; } = "";

}
