@*
    Presents authorized automatic-collection, retention and sampling information.
*@
@namespace Web.Components.Shared.Metrics
@inject AuthenticationStateProvider Authentication
@inject IServiceScopeFactory ServiceScopes

@if (_preferences is not null)
{
    <div class="telemetry-preferences">
        <details>
            <summary>Retention and sampling details</summary>
            <small>Saved build output and runtime logs/metrics retain until you delete the project. Operational provider
                views retain 30 days.
                Runtime logs and CPU/memory samples are collected and saved automatically while deployments are active,
                including while this page is closed. Active project terminals restore saved output after reload;
                inactive deployments remain available in deployment history.
                Metric history is sampled every 60 seconds by default; local live values update every few
                seconds.</small></details>
        @if (_error is not null)
        {
            <p role="alert">@_error</p>
        }
    </div>
}
else if (_error is not null)
{
    <p role="alert">@_error</p>
}
