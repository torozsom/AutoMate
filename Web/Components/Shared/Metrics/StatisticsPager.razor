@*
    Presents bounded numeric-table paging and supported row-count selection.
*@
@namespace Web.Components.Shared.Metrics
<nav class="statistics-pager" aria-label="@Label">
    <label>Rows per page <select class="form-select" value="@Size" @onchange="ResizeAsync">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
        </select></label>
    <span role="status">Page @Page of @Pages · @Total rows</span>
    <button type="button" class="btn btn-outline-secondary" disabled="@(Page <= 1)"
            @onclick="() => Change.InvokeAsync(Page - 1)">Previous
    </button>
    <button type="button" class="btn btn-outline-secondary" disabled="@(Page >= Pages)"
            @onclick="() => Change.InvokeAsync(Page + 1)">Next
    </button>
</nav>
