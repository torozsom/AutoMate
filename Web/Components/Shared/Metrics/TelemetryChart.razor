@*
    Presents observed SVG metric points with accessible pointer and keyboard inspection.
*@
@namespace Web.Components.Shared.Metrics
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<article class="telemetry-chart" @ref="_root">
    <div class="telemetry-chart-heading"><h3>@Title</h3>
        <span>@(Metric == TelemetryPresentation.Cpu ? "cores · UTC" : "UTC")</span></div>
    @if (Points.Count == 0)
    {
        <div class="telemetry-chart-empty">No observations in this period.</div>
    }
    else
    {
        var maximum = TelemetryPresentation.AxisMaximum(Points);
        var ordered = Points.OrderBy(p => p.Timestamp).ToArray();
        <svg viewBox="0 0 480 250" class="telemetry-chart-plot" tabindex="0" role="group"
             aria-label="@($"{Title}. Use left and right arrow keys to inspect observations. Values are also available in the numeric table.")">
            @for (var tick = 0; tick <= 4; tick++)
            {
                var y = 205 - tick * 43;
                <g>
                    <line x1="100" x2="455" y1="@y" y2="@y" class="telemetry-grid-line"/>
                    <text x="90" y="@(y + 4)" text-anchor="end"
                          class="telemetry-axis-label">@TelemetryPresentation.Format(maximum * tick / 4, Metric).Replace(" cores", "")</text>
                </g>
            }
            @for (var index = 0; index < ordered.Length; index++)
            {
                var point = ordered[index];
                var x = X(point.Timestamp);
                var y = 205 - 172 * point.Average / maximum;
                if (index > 0 && point.Timestamp - ordered[index - 1].Timestamp <= Gap)
                {
                    <line x1="@Number(X(ordered[index - 1].Timestamp))"
                          y1="@Number(205 - 172 * ordered[index - 1].Average / maximum)"
                          x2="@Number(x)" y2="@Number(y)" class="telemetry-series-line"/>
                }

                <circle cx="@Number(x)" cy="@Number(y)" r="4" class="telemetry-point"
                        data-detail="@Detail(point)"><title>@Detail(point)</title></circle>
            }
            <g>
                <text x="100" y="235"
                      class="telemetry-axis-label">@Start.ToString(AxisFormat, CultureInfo.InvariantCulture)</text>
                <text x="455" y="235" text-anchor="end"
                      class="telemetry-axis-label">@End.ToString(AxisFormat, CultureInfo.InvariantCulture)</text>
            </g>
        </svg>
        <p class="telemetry-chart-inspection" aria-live="polite" data-inspection>Hover or tap a point; use arrow keys
            when the chart is focused.</p>
        @if (Points.Count == 1)
        {
            <p class="telemetry-chart-note">One observation—insufficient data for a trend.</p>
        }
    }
</article>
