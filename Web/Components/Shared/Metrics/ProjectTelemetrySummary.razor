@*
    Loads and presents owner-scoped project aggregates for the selected metric window.
*@
@namespace Web.Components.Shared.Metrics
@using Application.Abstractions.Diagnostics.Metrics
@implements IDisposable
@inject IServiceScopeFactory ServiceScopes
@inject ILogger<ProjectTelemetrySummary> Logger

<div class="telemetry-panel" aria-labelledby="project-analytics-title" aria-busy="@_busy">
    <div class="telemetry-toolbar">
        <div><h3 id="project-analytics-title">Project analytics</h3>
            <p class="telemetry-muted">Recorded observations across this project's deployments</p></div>
        <MetricRangePicker Changed="RangeChangedAsync"/>
    </div>
    @if (_busy)
    {
        <p class="telemetry-muted" role="status">Loading analytics…</p>
    }
    @if (_summary is { } summary)
    {
        <div class="telemetry-kpis">
            <div class="telemetry-kpi"><span>Deployments</span><strong>@summary.Deployments</strong><small>In the
                    selected period</small></div>
            <div class="telemetry-kpi">
                <span>Successful / failed</span><strong>@summary.SuccessfulDeployments / @summary.FailedDeployments</strong><small>Deployment
                    outcomes</small></div>
            <div class="telemetry-kpi">
                <span>Average CPU</span><strong>@Average(TelemetryPresentation.Cpu)</strong><small>Per observed
                    container</small></div>
            <div class="telemetry-kpi">
                <span>Average memory</span><strong>@Average(TelemetryPresentation.Memory)</strong><small>Per observed
                    container</small></div>
        </div>
        <div class="telemetry-support">
            <span>Observed log errors: <strong>@(summary.CompleteDayLogErrors?.ToString() ?? (summary.Daily.Any(d => d.Metric == "observed_log_errors") ? summary.Daily.Where(d => d.Metric == "observed_log_errors").Sum(d => d.ObservedErrors).ToString() : "—"))</strong> · approximate, complete UTC days</span>
            @if (summary.AverageDeploymentSeconds is { } seconds)
            {
                <span>Average completed deployment: @TimeSpan.FromSeconds(seconds).ToString("g")</span>
            }
            @if (summary.Daily.Count > 0)
            {
                <span>Updated @summary.Daily.Max(r => r.UpdatedAt).ToString("u")</span>
            }
        </div>
        @if (_notice is not null)
        {
            <p class="telemetry-notice" role="status">@_notice</p>
        }

        <details class="telemetry-explore">
            <summary>Explore metrics <span>CPU, memory and paginated statistics</span></summary>
            <MetricStatisticsView Data="@Observations" Range="@(new MetricTimeRange(_start, _end))"
                                  Availability="@_notice"/>
        </details>
    }
    else
    {
        <p class="telemetry-notice" role="status">@(_notice ?? "No analytics available yet.")</p>
    }
</div>
