@*
    Presents metric charts and an independent paginated numeric alternative from recorded aggregates.
*@
@namespace Web.Components.Shared.Metrics
<div class="metric-statistics-view">
    @if (Availability is not null)
    {
        <p class="telemetry-notice" role="status">@Availability</p>
    }
    <p class="telemetry-muted">Average observed container usage · @Range.Aggregation. Missing observations remain gaps.
        @Data.Sum(p => p.Samples) observed samples · @Data.Select(p => p.Timestamp).Distinct().Count() aggregation
        buckets containing observations.
        @if (Data.Any(p => p.ImportedIntervals > 0))
        {
            <span>Imported interval averages have no raw sample counts.</span>
        }
    </p>
    <div class="telemetry-chart-grid">
        <TelemetryChart Title="CPU usage" Metric="@TelemetryPresentation.Cpu"
                        Points="@Points(TelemetryPresentation.Cpu)"
                        Start="Range.Start" End="Range.End" Gap="@(Range.Interval + TimeSpan.FromSeconds(5))"/>
        <TelemetryChart Title="Memory usage" Metric="@TelemetryPresentation.Memory"
                        Points="@Points(TelemetryPresentation.Memory)"
                        Start="Range.Start" End="Range.End" Gap="@(Range.Interval + TimeSpan.FromSeconds(5))"/>
    </div>
    <details class="telemetry-table-details">
        <summary>Numeric metric statistics</summary>
        <div class="table-responsive">
            <table class="table telemetry-table">
                <caption>UTC @Range.Aggregation by deployment and container; first and last buckets are clipped to the
                    selected range; pagination does not change charts
                </caption>
                <thead>
                <tr>
                    <th scope="col">UTC bucket</th>
                    <th scope="col">Deployment</th>
                    <th scope="col">Container</th>
                    <th scope="col">Metric</th>
                    <th scope="col">Average</th>
                    <th scope="col">Minimum</th>
                    <th scope="col">Maximum</th>
                    <th scope="col">Samples / imported intervals</th>
                    <th scope="col">Quality</th>
                </tr>
                </thead>
                <tbody>@foreach (var row in Rows)
                {
                    <tr>
                        <td>@row.Timestamp.ToString("u")</td>
                        <td>
                            <a href="@($"/project/{row.Project}/deployment/{row.Deployment}")">@row.Deployment.ToString("N")[..8]</a>
                        </td>
                        <td>@row.Container</td>
                        <td>@TelemetryPresentation.Label(row.Metric)</td>
                        <td>@TelemetryPresentation.Format(row.Average, row.Metric)</td>
                        <td>@TelemetryPresentation.Format(row.Minimum, row.Metric)</td>
                        <td>@TelemetryPresentation.Format(row.Maximum, row.Metric)</td>
                        <td>@(row.ImportedIntervals > 0 ? $"{row.ImportedIntervals} imported intervals" : $"{row.Samples} samples")</td>
                        <td>@(row.Incomplete ? "Partial" : "Observed")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <StatisticsPager Label="Metric statistics pages" Total="Data.Count" Page="_page" Size="_size"
                         Change="SetPage" SizeChanged="SetSize"/>
    </details>
</div>
