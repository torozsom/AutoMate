@*
    Selects relative or explicit frozen UTC windows and validates range bounds before publication.
*@
@namespace Web.Components.Shared.Metrics
<div class="metric-range-picker">
    <label for="@(_id + "-period")">Period (UTC)
        <select id="@(_id + "-period")" class="form-select" value="@_choice" @onchange="ChooseAsync">
            @foreach (var option in Choices)
            {
                <option value="@option.Key">@option.Value</option>
            }
            @if (LifetimeStart is not null)
            {
                <option value="lifetime">Deployment lifetime</option>
            }
            <option value="custom">Custom UTC range</option>
        </select>
    </label>
    @if (_choice == "custom")
    {
        <label for="@(_id + "-start")">From (UTC)<input id="@(_id + "-start")" type="datetime-local"
                                                        class="form-control" @bind="_start"/></label>
        <label for="@(_id + "-end")">To (UTC)<input id="@(_id + "-end")" type="datetime-local" class="form-control"
                                                    @bind="_end"/></label>
        <button type="button" class="btn btn-outline-primary" @onclick="ApplyAsync">Apply range</button>
    }
    @if (_notice is not null)
    {
        <p class="telemetry-notice" role="status">@_notice</p>
    }
</div>
