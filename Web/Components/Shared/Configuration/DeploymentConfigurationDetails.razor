@*
    Presents recorded launch settings with safe links and explicitly selected metadata copying.
*@
@namespace Web.Components.Shared.Configuration
@if (Deployment is not null)
{
    var snapshot = Snapshot;
    <div class="configuration-tables">
        <section class="configuration-table-group"><h3>Application</h3>
            <table class="table console-table">
                <caption class="visually-hidden">Recorded application configuration</caption>
                <tbody>
                <RecordedValueRow Label="Project" Value="@(snapshot?.ProjectName ?? Deployment.CsProject?.Name)"/>
                <RecordedValueRow Label="Provider"
                                  Value="@(snapshot?.Provider ?? (Deployment.CloudGitHubActionRunId is not null ? "Azure Container Apps" : null))"/>
                <RecordedValueRow Label="Runtime" Value="@(snapshot?.Runtime)"/>
                <RecordedValueRow Label="Environment" Value="@(snapshot?.Environment)"/>
                <RecordedValueRow Label="Port"
                                  Value="@(Deployment.ResolvedHostPort?.ToString() ?? snapshot?.Port.ToString())"/>
                </tbody>
            </table>
        </section>
        <section class="configuration-table-group"><h3>Infrastructure</h3>
            <table class="table console-table">
                <caption class="visually-hidden">Recorded infrastructure configuration</caption>
                <tbody>
                <RecordedValueRow Label="Resource group" Value="@(snapshot?.ResourceGroup ?? CloudMissing)"/>
                <RecordedValueRow Label="Container App"
                                  Value="@(Deployment.CloudContainerAppName ?? snapshot?.ContainerApp ?? CloudMissing)"/>
                <RecordedValueRow Label="Region" Value="@(snapshot?.Region ?? CloudMissing)"/>
                <RecordedValueRow Label="Registry / image"
                                  Value="@(string.Join(" / ", new[] { snapshot?.Registry, snapshot?.Image ?? Deployment.ImageTag }.Where(v => !string.IsNullOrWhiteSpace(v))))"
                                  Copyable="true"/>
                </tbody>
            </table>
        </section>
        <section class="configuration-table-group"><h3>Source and workflow</h3>
            <table class="table console-table">
                <caption class="visually-hidden">Recorded source identity</caption>
                <tbody>
                @if (SourceUrl is { } source)
                {
                    <tr>
                        <th scope="row">Repository</th>
                        <td><a href="@source" target="_blank" rel="noopener noreferrer">@source ↗</a></td>
                    </tr>
                }
                else
                {
                    <RecordedValueRow Label="Repository" Value="@(snapshot?.SourceUrl)"/>
                }
                <RecordedValueRow Label="Branch" Value="@(snapshot?.Branch)"/>
                <RecordedValueRow Label="Commit" Value="@(snapshot?.Commit)" Copyable="true"/>
                @if (WorkflowUrl is { } workflow)
                {
                    <tr>
                        <th scope="row">Workflow</th>
                        <td><a href="@workflow" target="_blank" rel="noopener noreferrer">Open workflow ↗</a></td>
                    </tr>
                }
                else
                {
                    <RecordedValueRow Label="Workflow" Value="@CloudMissing"/>
                }
                </tbody>
            </table>
        </section>
        <section class="configuration-table-group"><h3>Access</h3>
            <table class="table console-table">
                <caption class="visually-hidden">Recorded access links; resources may no longer exist</caption>
                <tbody>
                <tr>
                    <th scope="row">Application URL</th>
                    <td>@if (AppUrl is { } app)
                        {
                            <a href="@app" target="_blank" rel="noopener noreferrer">@app ↗</a>
                        }
                        else
                        {
                            <span>Not recorded</span>
                        }
                    </td>
                </tr>
                @if (ResourceUrl is { } resource)
                {
                    <tr>
                        <th scope="row">Azure Portal</th>
                        <td><a href="@resource" target="_blank" rel="noopener noreferrer">Open recorded resource ↗</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    </div>
    <details class="console-details">
        <summary>Additional details <span class="console-meta"> · provider identifiers and database composition</span>
        </summary>
        <div class="configuration-table-group">
            <table class="table console-table">
                <caption class="visually-hidden">Additional recorded non-secret deployment metadata</caption>
                <tbody>
                <RecordedValueRow Label="Revision" Value="@(Deployment.CloudContainerRevision ?? CloudMissing)"
                                  Copyable="true"/>
                <RecordedValueRow Label="Docker container"
                                  Value="@(Deployment.DockerContainerId ?? (snapshot is { Provider: { } provider } && provider.Contains("Azure", StringComparison.OrdinalIgnoreCase) ? "Not applicable" : null))"
                                  Copyable="true"/>
                <RecordedValueRow Label="Workflow run"
                                  Value="@(Deployment.CloudGitHubActionRunId?.ToString() ?? CloudMissing)"
                                  Copyable="true"/>
                <RecordedValueRow Label="Azure resource ID" Value="@(Deployment.CloudResourceId ?? CloudMissing)"
                                  Copyable="true"/>
                @foreach (var database in snapshot?.Databases ?? [])
                {
                    <RecordedValueRow Label="Database / container"
                                      Value="@($"{database.Provider} / {database.Name} / {database.ContainerSuffix}")"/>
                }
                </tbody>
            </table>
        </div>
    </details>
    <p class="console-meta">Recorded values describe this deployment. They do not confirm that historical resources are
        still accessible.</p>
    @if (snapshot is null)
    {
        <p class="telemetry-muted">This deployment predates configuration snapshots. Missing historical settings cannot
            be reconstructed.</p>
    }
}
else
{
    <p class="telemetry-muted">No deployment has been recorded yet.</p>
}
