@*
    Presents a recorded metadata value and an optional browser clipboard action.
*@
@namespace Web.Components.Shared.Configuration
@inject IJSRuntime JS
<tr>
    <th scope="row">@Label</th>
    <td>
        <div class="recorded-value"><span>@(string.IsNullOrWhiteSpace(Value) ? "Not recorded" : Value)</span>
            @if (!string.IsNullOrWhiteSpace(Value) && Copyable)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="@($"Copy {Label}")"
                        @onclick="CopyAsync">@(_copied ? "Copied" : "Copy")</button>
            }
        </div>
        @if (_failed)
        {
            <small role="status">Clipboard unavailable; select and copy the value.</small>
        }
    </td>
</tr>
