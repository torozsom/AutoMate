@using Application.Abstractions.Diagnostics
@using Application.Data.Users
@using Web.Components.Pages
@inject AuthenticationStateProvider Authentication
@inject IUserService Users
@inject IDeploymentHistoryService History

@if (_preferences is not null)
{
    <div class="telemetry-preferences">
        <label class="form-check">
            <input class="form-check-input" type="checkbox" checked="@_preferences.RuntimeEnabled"
                   @onchange="ChangeRuntimeAsync"/>
            <span class="form-check-label">Continue collecting runtime logs and CPU/memory samples while this page is closed</span>
        </label>
        @if (_preferences.ManagedService)
        {
            <label class="form-check mt-2">
                <input class="form-check-input" type="checkbox" checked="@_preferences.ManagedConsent"
                       @onchange="ChangeConsentAsync"/>
                <span class="form-check-label">Allow redacted diagnostics to be sent to the configured managed provider in @_preferences.ProcessingRegion</span>
            </label>
        }
        <details><summary>Retention and sampling details</summary><small>Build output and runtime logs/metrics collected while this page is open are saved for 30 days.
            Web and database terminals restore saved output after reload. Enable background collection above to collect
            while the page is closed.
            Metric history is sampled every 60 seconds by default; local live values update every few seconds.</small></details>
        @if (_error is not null)
        {
            <p role="alert">@_error</p>
        }
    </div>
}
else if (_error is not null)
{
    <p role="alert">@_error</p>
}

@code {

    /// <summary>Owner's project.</summary>
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>Current authorized preferences.</summary>
    private DeploymentTelemetryPreferences? _preferences;

    /// <summary>Internal owner identity.</summary>
    private Guid _owner;

    /// <summary>Safe operation failure.</summary>
    private string? _error;

    /// <summary>Avoids repeated database reads for unchanged parent parameters.</summary>
    private Guid _loadedProject;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProject == ProjectId) return;
        _loadedProject = ProjectId;
        _preferences = null;
        try
        {
            _owner = await AuthenticatedUserResolver.GetCurrentUserIdAsync(Authentication, Users);
            if (_owner != Guid.Empty) _preferences = await History.GetPreferencesAsync(_owner, ProjectId);
            _error = null;
        }
        catch (Exception)
        {
            _error = "Unable to load diagnostic collection preferences.";
        }
    }

    /// <summary>Records ongoing-collection consent.</summary>
    private async Task ChangeRuntimeAsync(ChangeEventArgs args)
    {
        await SaveAsync(args.Value is true, false);
    }

    /// <summary>Records external-provider consent.</summary>
    private async Task ChangeConsentAsync(ChangeEventArgs args)
    {
        await SaveAsync(args.Value is true, true);
    }

    /// <summary>Persists the chosen preference and refreshes the authoritative value.</summary>
    private async Task SaveAsync(bool enabled, bool managed)
    {
        try
        {
            if (managed) await History.SetManagedConsentAsync(_owner, ProjectId, enabled);
            else await History.SetRuntimeCollectionAsync(_owner, ProjectId, enabled);
            _preferences = await History.GetPreferencesAsync(_owner, ProjectId);
            _error = null;
        }
        catch (Exception)
        {
            _error = "Unable to update diagnostic collection preferences.";
        }
    }

}
