@using Application.Abstractions.Diagnostics
@using Application.Data.Users
@using Web.Components.Pages
@inject AuthenticationStateProvider Authentication
@inject IUserService Users
@inject IDeploymentHistoryService History

@if (_preferences is not null)
{
    <div class="telemetry-preferences">
        <details>
            <summary>Retention and sampling details</summary>
            <small>Saved build output and runtime logs/metrics retain until you delete the project. Operational provider
                views retain 30 days.
                Runtime logs and CPU/memory samples are collected and saved automatically while deployments are active,
                including while this page is closed. Active project terminals restore saved output after reload;
                inactive deployments remain available in deployment history.
                Metric history is sampled every 60 seconds by default; local live values update every few
                seconds.</small></details>
        @if (_error is not null)
        {
            <p role="alert">@_error</p>
        }
    </div>
}
else if (_error is not null)
{
    <p role="alert">@_error</p>
}

@code {

    /// <summary>Owner's project.</summary>
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>Current authorized preferences.</summary>
    private DeploymentTelemetryPreferences? _preferences;

    /// <summary>Internal owner identity.</summary>
    private Guid _owner;

    /// <summary>Safe operation failure.</summary>
    private string? _error;

    /// <summary>Avoids repeated database reads for unchanged parent parameters.</summary>
    private Guid _loadedProject;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProject == ProjectId) return;
        _loadedProject = ProjectId;
        _preferences = null;
        try
        {
            _owner = await AuthenticatedUserResolver.GetCurrentUserIdAsync(Authentication, Users);
            if (_owner != Guid.Empty) _preferences = await History.GetPreferencesAsync(_owner, ProjectId);
            _error = null;
        }
        catch (Exception)
        {
            _error = "Unable to load diagnostic collection preferences.";
        }
    }


}
