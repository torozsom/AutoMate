@using Application.Abstractions.Diagnostics
@implements IDisposable
@inject IServiceScopeFactory ServiceScopes
@inject ILogger<ProjectTelemetrySummary> Logger

<div class="telemetry-panel" aria-labelledby="project-analytics-title" aria-busy="@_busy">
    <div class="telemetry-toolbar">
        <div><h3 id="project-analytics-title">Project analytics</h3>
            <p class="telemetry-muted">Recorded observations across this project's deployments</p></div>
        <MetricRangePicker Changed="RangeChangedAsync"/>
    </div>
    @if (_busy)
    {
        <p class="telemetry-muted" role="status">Loading analytics…</p>
    }
    @if (_summary is { } summary)
    {
        <div class="telemetry-kpis">
            <div class="telemetry-kpi"><span>Deployments</span><strong>@summary.Deployments</strong><small>In the
                    selected period</small></div>
            <div class="telemetry-kpi">
                <span>Successful / failed</span><strong>@summary.SuccessfulDeployments / @summary.FailedDeployments</strong><small>Deployment
                    outcomes</small></div>
            <div class="telemetry-kpi">
                <span>Average CPU</span><strong>@Average(TelemetryPresentation.Cpu)</strong><small>Per observed
                    container</small></div>
            <div class="telemetry-kpi">
                <span>Average memory</span><strong>@Average(TelemetryPresentation.Memory)</strong><small>Per observed
                    container</small></div>
        </div>
        <div class="telemetry-support">
            <span>Observed log errors: <strong>@(summary.CompleteDayLogErrors?.ToString() ?? (summary.Daily.Any(d => d.Metric == "observed_log_errors") ? summary.Daily.Where(d => d.Metric == "observed_log_errors").Sum(d => d.ObservedErrors).ToString() : "—"))</strong> · approximate, complete UTC days</span>
            @if (summary.AverageDeploymentSeconds is { } seconds)
            {
                <span>Average completed deployment: @TimeSpan.FromSeconds(seconds).ToString("g")</span>
            }
            @if (summary.Daily.Count > 0)
            {
                <span>Updated @summary.Daily.Max(r => r.UpdatedAt).ToString("u")</span>
            }
        </div>
        @if (_notice is not null)
        {
            <p class="telemetry-notice" role="status">@_notice</p>
        }

        <details class="telemetry-explore">
            <summary>Explore metrics <span>CPU, memory and paginated statistics</span></summary>
            <MetricStatisticsView Data="@Observations" Range="@(new MetricTimeRange(_start, _end))"
                                  Availability="@_notice"/>
        </details>
    }
    else
    {
        <p class="telemetry-notice" role="status">@(_notice ?? "No analytics available yet.")</p>
    }
</div>

@code {

    /// <summary>Authorized project whose daily statistics are displayed.</summary>
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>The parent page's resolved owner; the analytics service still verifies project ownership.</summary>
    [Parameter]
    public Guid UserId { get; set; }

    /// <summary>Frozen range selected by the shared UTC controls.</summary>
    private MetricTimeRange _range = MetricTimeRange.Preset("30d", DateTimeOffset.UtcNow);

    /// <summary>Changes the range without rewriting saved analysis preferences.</summary>
    private async Task RangeChangedAsync(MetricTimeRange range)
    {
        _range = range;
        await LoadAsync();
    }

    /// <summary>Compatible legacy summaries retain their recorded container identity.</summary>
    private IReadOnlyList<MetricObservation> Observations => _summary?.Observations?.Chart ??
                                                             _summary?.Daily.Where(p => p.Average is not null).Select(p => new MetricObservation(ProjectId, p.DeploymentId,
                                                                 p.Container, p.Metric, p.Unit, p.DayUtc, p.SampleCount, p.Average!.Value * Math.Max(1, p.SampleCount),
                                                                 p.Minimum ?? p.Average.Value, p.Maximum ?? p.Average.Value, p.Incomplete)).ToArray() ?? [];

    /// <summary>Loaded project identity.</summary>
    private Guid _loaded;

    /// <summary>Loaded owner identity.</summary>
    private Guid _loadedOwner;

    /// <summary>Indicates an independently scoped statistics request.</summary>
    private bool _busy;

    /// <summary>Fixed unavailable or partial-data guidance.</summary>
    private string? _notice;

    /// <summary>Last accepted owner/project/range projection.</summary>
    private ProjectTelemetryAnalytics? _summary;

    /// <summary>Cancels requests on navigation.</summary>
    private readonly CancellationTokenSource _lifetime = new();

    /// <summary>Cancellation source for the most recently requested period.</summary>
    private CancellationTokenSource? _load;

    /// <summary>Bounds shared summary and chart time ranges.</summary>
    private DateTimeOffset _start, _end;

    /// <summary>Formats a sample-weighted project resource average.</summary>
    private string Average(string metric)
    {
        var points = Observations.Where(p => p.Metric == metric).ToArray();
        var raw = points.Where(p => p.Samples > 0).ToArray();
        var values = raw.Length > 0 ? raw : points;
        return TelemetryPresentation.Format(values.Length == 0
            ? null
            : values.Sum(p => p.Sum) /
              Math.Max(1, values.Sum(p => p.Samples > 0 ? p.Samples : p.ImportedIntervals)), metric);
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == ProjectId && _loadedOwner == UserId) return;
        _loadedOwner = UserId;
        _summary = null;
        _loaded = ProjectId;
        await LoadAsync();
    }

    /// <summary>Loads an independently scoped period and discards cancelled or obsolete responses.</summary>
    private async Task LoadAsync()
    {
        _load?.Cancel();
        using var request = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _load = request;
        _busy = true;
        try
        {
            // Blazor children may load while their parent is querying; never share the circuit's EF context.
            await using var scope = ServiceScopes.CreateAsyncScope();
            var analytics = scope.ServiceProvider.GetRequiredService<IProjectTelemetryAnalytics>();
            var now = _range.End;
            var start = _range.Start;
            var owner = UserId;
            var project = ProjectId;
            var result = await analytics.ReadAsync(owner, project, start, now, request.Token);
            if (request.IsCancellationRequested || owner != UserId || project != ProjectId) return;
            _start = start;
            _end = now;
            _summary = result;
            _notice = _summary.Availability;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (request.IsCancellationRequested) return;
            _summary = null;
            _notice = "Project analytics are temporarily unavailable.";
            Logger.LogWarning("Project analytics unavailable: {FailureType}.", ex.GetType().Name);
        }
        finally
        {
            if (ReferenceEquals(_load, request))
            {
                _busy = false;
                _load = null;
            }
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

}
