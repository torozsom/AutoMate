@using Application.Abstractions.Ai
@using Application.Ai
@using Domain.Enums
<section class="card my-4 analysis-panel" aria-labelledby="@_headingId">
    <div class="card-body">
        <h2 id="@_headingId" class="h5">AI deployment analysis</h2>
        <p>Review diagnostic suggestions before acting. Suggestions are never executed automatically.</p>
        @if (!ReadOnly)
        {
            <div class="mb-3">
                <p id="@(_headingId + "-consent")">Diagnostic data egress:
                    <strong>@(Consented ? "Allowed" : "Not allowed")</strong>.
                    Consent allows bounded, redacted deployment logs, metrics and project context to be sent to the
                    configured AI provider.
                    Operator policy still applies. Revoking consent prevents future provider requests; data already sent
                    cannot be recalled.</p>
                <button type="button" class="btn btn-outline-secondary" disabled="@(Busy || !CanEditConsent)"
                        aria-describedby="@(_headingId + "-consent")"
                        @onclick="() => OnConsentChange.InvokeAsync(!Consented)">
                    @(Consented ? "Revoke diagnostic data egress consent" : "Allow diagnostic data egress")
                </button>
                @if (!CanEditConsent)
                {
                    <p class="mt-2">Consent can be changed when the current deployment has an eligible project.</p>
                }
            </div>
        }
        <p role="status" aria-live="polite" aria-atomic="true"><strong>@StatusLabel</strong> @Explanation</p>
        @if (CurrentResult is { } result)
        {
            <dl class="row">
                <dt class="col-sm-3">Requested</dt>
                <dd class="col-sm-9">
                    <time datetime="@result.CreatedAt.ToString("O")">@Timestamp(result.CreatedAt)</time>
                </dd>
                <dt class="col-sm-3">Trigger</dt>
                <dd class="col-sm-9">@(result.Trigger == AiAnalysisTrigger.DeploymentFailed ? "Automatic after deployment failure" : "Owner request")</dd>
                @if (result.CompletedAt is { } completed)
                {
                    <dt class="col-sm-3">Finished</dt>
                    <dd class="col-sm-9">
                        <time datetime="@completed.ToString("O")">@Timestamp(completed)</time>
                    </dd>
                }
                @if (result.Status == AiAnalysisStatus.Completed)
                {
                    <dt class="col-sm-3">Provider / model</dt>
                    <dd class="col-sm-9 text-break">@(result.Provider ?? "Not recorded") / @(result.Model ?? "Not recorded")</dd>
                    <dt class="col-sm-3">Prompt / schema</dt>
                    <dd class="col-sm-9 text-break">@(result.PromptVersion ?? "Not recorded") / @(result.ResultSchemaVersion?.ToString() ?? "Not recorded")</dd>
                    @if (result.RequestedModel is not null)
                    {
                        <dt class="col-sm-3">Requested model</dt>
                        <dd class="col-sm-9 text-break">@result.RequestedModel</dd>
                    }

                    @if (result.ModelVersion is not null)
                    {
                        <dt class="col-sm-3">Model revision</dt>
                        <dd class="col-sm-9 text-break">@result.ModelVersion</dd>
                    }
                }
            </dl>
            @if (result.Assessment is { } assessment)
            {
                <p class="small"><strong>@AssessmentContextControls.FocusLabel(assessment.EffectiveKind)</strong> ·
                    Observed @assessment.ObservedStatus / @assessment.ObservedOutcome at @Timestamp(assessment.CollectedAt).
                </p>
                <p class="small">Evidence
                    range: @Timestamp(assessment.Window.Start) – @Timestamp(assessment.Window.End).
                    Sources: @assessment.Requested.Sources.
                    Metrics: @(assessment.Requested.IncludeMetrics ? "Included" : "Excluded").</p>
                <p class="small text-break">Requested
                    focus: @AssessmentContextControls.FocusLabel(assessment.Requested.Kind).
                    Log
                    containers: @(assessment.Requested.LogContainers is null ? "All recorded" : assessment.Requested.LogContainers.Length == 0 ? "None" : string.Join(", ", assessment.Requested.LogContainers)).
                    Metric
                    containers: @(assessment.Requested.MetricContainers is null ? "All recorded" : assessment.Requested.MetricContainers.Length == 0 ? "None" : string.Join(", ", assessment.Requested.MetricContainers)).</p>
                @if (assessment.Window.Truncated)
                {
                    <p>Deployment lifetime exceeded 365 days; this assessment covers its latest 365 days.</p>
                }
            }
            else
            {
                <p class="small text-muted">Collected context choices and observed deployment status are unknown for
                    this run.</p>
            }

            @if (result.Status == AiAnalysisStatus.Completed)
            {
                <h3 class="h6">@(result.Sections is null ? "Summary" : "Overview")</h3>
                <p class="text-break" style="white-space: pre-wrap">@result.Summary</p>
                @if (result.Sections is { } sections)
                {
                    <AssessmentResultSection Title="Observations" Items="sections.Observations"
                                             EmptyMessage="No additional observations were recorded."/>
                    <AssessmentResultSection Title="Metrics assessment" Items="sections.MetricsAssessment"
                                             EmptyMessage="No metric assessment was supported by the selected evidence."/>
                    <AssessmentResultSection Title="Potential issues" Items="sections.PotentialIssues"
                                             EmptyMessage="No potential issues were identified in the selected evidence; this is not proof of overall health."/>
                }

                <h3 class="h6">@(result.Sections is null ? "Recommended steps" : "Recommendations")</h3>
                @if (result.RecommendedSteps.Count == 0)
                {
                    <p>No recommended steps were recorded.</p>
                }
                else
                {
                    <ol>@foreach (var step in result.RecommendedSteps)
                        {
                            <li class="text-break">@step</li>
                        }
                    </ol>
                }

                @if (result.Sections is { } bounded)
                {
                    <AssessmentResultSection Title="Limitations" Items="bounded.Limitations"
                                             EmptyMessage="No additional limitations were recorded; conclusions apply only to the selected evidence."/>
                }

                <h3 class="h6">Evidence references</h3>
                @if (result.EvidenceReferences.Count == 0)
                {
                    <p>No evidence references were recorded.</p>
                }
                else
                {
                    <ul>@foreach (var reference in result.EvidenceReferences)
                        {
                            <li class="text-break">@reference</li>
                        }
                    </ul>
                }
            }
        }
        @if (!ReadOnly)
        {
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-primary" disabled="@(!CanRequest)" @onclick="OnRequest">
                    Analyze
                    deployment
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled="@(Busy || DeploymentId is null)"
                        @onclick="OnRefresh">Refresh analysis
                </button>
                @if (CurrentResult?.Status is AiAnalysisStatus.Queued or AiAnalysisStatus.Running)
                {
                    <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="OnCancel">Cancel
                        analysis
                    </button>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="mt-3 mb-0" role="status" aria-live="polite">@Message</p>
        }
    </div>
</section>

@code {

    /// <summary>Saved-run presentation hides consent edits and execution controls.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>Unique accessible heading association when multiple panels are rendered.</summary>
    private readonly string _headingId = "analysis-" + Guid.NewGuid().ToString("N");

    /// <summary>Actual current deployment identity; stale results are omitted.</summary>
    [Parameter]
    public Guid? DeploymentId { get; set; }

    /// <summary>Owner-authorized safe result supplied by the Application use case.</summary>
    [Parameter]
    public DeploymentAnalysisView? Result { get; set; }

    /// <summary>Operator AI enablement; never implies provider approval.</summary>
    [Parameter]
    public bool Enabled { get; set; }

    /// <summary>Consent on the actual deployment's project configuration.</summary>
    [Parameter]
    public bool Consented { get; set; }

    /// <summary>Whether the current deployment has an exact eligible project whose consent can be edited.</summary>
    [Parameter]
    public bool CanEditConsent { get; set; }

    /// <summary>Whether the current deployment has persisted Failed status.</summary>
    [Parameter]
    public bool FailedDeployment { get; set; }

    /// <summary>Allows an operational assessment of any persisted deployment status.</summary>
    [Parameter]
    public bool AllowAnyStatus { get; set; }

    /// <summary>Disables duplicate owner actions while a request or refresh is pending.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Authored action feedback, rendered as encoded text.</summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>Owner request callback; the panel does not access persistence or provider services.</summary>
    [Parameter]
    public EventCallback OnRequest { get; set; }

    /// <summary>Owner refresh callback; persisted state remains authoritative.</summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    /// <summary>Explicit owner consent change; no provider is called by the panel.</summary>
    [Parameter]
    public EventCallback<bool> OnConsentChange { get; set; }

    /// <summary>Owner cancellation of the current queued/running analysis.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>Rejects a response belonging to an older deployment selection.</summary>
    private DeploymentAnalysisView? CurrentResult => Result?.DeploymentId == DeploymentId ? Result : null;

    /// <summary>Matches UI eligibility to existing owner admission gates without replacing server authorization.</summary>
    private bool CanRequest => !Busy && Enabled && Consented && (FailedDeployment || AllowAnyStatus) && DeploymentId is not null &&
                               CurrentResult?.Status is not (AiAnalysisStatus.Queued or AiAnalysisStatus.Running);

    /// <summary>Textual status conveys meaning without depending on color.</summary>
    private string StatusLabel => CurrentResult?.Status switch
    {
        AiAnalysisStatus.Queued => "Queued", AiAnalysisStatus.Running => "Processing",
        AiAnalysisStatus.Completed => "Completed", AiAnalysisStatus.Cancelled => "Canceled",
        AiAnalysisStatus.Skipped => "Skipped", AiAnalysisStatus.Failed => "Analysis failed",
        _ => "No analysis yet"
    };

    /// <summary>Fixed state and eligibility guidance; raw failure codes and nonterminal payloads are never rendered.</summary>
    private string Explanation => CurrentResult?.Status switch
    {
        AiAnalysisStatus.Skipped => AnalysisSkipPolicy.Message(CurrentResult.FailureCode),
        AiAnalysisStatus.Cancelled => "The owner canceled this analysis.",
        AiAnalysisStatus.Failed when CurrentResult.FailureCode == AnalysisProviderAccessDeniedException.FailureCode => AnalysisProviderAccessDeniedException.Guidance,
        AiAnalysisStatus.Failed => "No complete result is available. You can request another analysis when enabled.",
        _ when Busy => "Updating analysis…",
        _ when !Enabled => "New AI analysis is disabled by the operator. Saved results remain available.",
        _ when !Consented => "Diagnostic data egress consent is not enabled for this deployment's project.",
        _ when !FailedDeployment && !AllowAnyStatus => "Analysis requests are available after a deployment fails.",
        AiAnalysisStatus.Queued or AiAnalysisStatus.Running => "Status refreshes automatically every five seconds. You can also use Refresh analysis.",
        _ => "Analysis uses diagnostic data approved for this project."
    };

    /// <summary>Explicit UTC timestamps prevent ambiguous deployment timing.</summary>
    private static string Timestamp(DateTimeOffset value)
    {
        return value.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'");
    }

}
