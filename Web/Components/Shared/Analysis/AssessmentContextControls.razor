@using Application.Ai.Context
@using Domain.Enums.Deployments
@*
    Edits immutable analysis choices for sources, containers, metrics, focus and UTC time bounds.
*@
@namespace Web.Components.Shared
<fieldset class="assessment-context" disabled="@Disabled">
    <legend class="h6">Assessment context</legend>
    <div class="assessment-options">
        <label>Assessment focus
            <select class="form-select" value="@((int)Selection.Kind)" @onchange="KindChanged">
                <option value="0">Automatic</option>
                <option value="1">Startup assessment</option>
                <option value="2">Failure diagnosis</option>
                <option value="3">Runtime overview</option>
                <option value="4">Historical review</option>
            </select>
        </label>
        <label>Time range
            <select class="form-select" value="@((int)Selection.Range)" @onchange="RangeChanged">
                <option value="0">Automatic for status</option>
                <option value="1">Last 15 minutes</option>
                <option value="2">Last hour</option>
                <option value="3">Last 24 hours</option>
                <option value="4">Deployment lifetime</option>
                <option value="5">Custom UTC range</option>
            </select>
        </label>
    </div>
    <p class="small text-muted">Automatic currently selects @FocusLabel(Selection.Resolve(Status)). The worker checks
        the status again when it collects evidence.
        Default
        range: @(Status is DeploymentStatus.Starting or DeploymentStatus.Running ? "Last hour" : "Deployment lifetime").</p>
    @if (Selection.Range == AssessmentRange.Custom)
    {
        <div class="assessment-options">
            <label>From (UTC)<input class="form-control" type="datetime-local" value="@UtcValue(Selection.Start)"
                                    @onchange="StartChanged"/></label>
            <label>Until (UTC)<input class="form-control" type="datetime-local" value="@UtcValue(Selection.End)"
                                     @onchange="EndChanged"/></label>
        </div>
    }
    <p class="small">A single range covers at most 365 days. Longer deployment lifetimes use their latest 365 days, with
        a saved truncation notice.</p>
    <div class="assessment-sources">
        @foreach (var source in Sources)
        {
            <div>
                <label><input type="checkbox" disabled="@UnsupportedSources.HasFlag(source)"
                              checked="@Selection.Sources.HasFlag(source)" @onchange="e => SourceChanged(source, e)"/>
                    @SourceLabel(source)</label>
                @if (UnsupportedSources.HasFlag(source))
                {
                    <span class="small text-muted"> — Unsupported for this recorded deployment</span>
                }
                else if (!Channels.Any(c => c.Source == source))
                {
                    <span class="small text-muted"> — No recorded output yet</span>
                }
                @if (source is AssessmentSources.Web or AssessmentSources.Database)
                {
                    @foreach (var channel in Channels.Where(c => c.Source == source))
                    {
                        <label class="assessment-container"><input type="checkbox"
                                                                   disabled="@(!Selection.Sources.HasFlag(source))"
                                                                   checked="@(Selection.LogContainers is null || Selection.LogContainers.Contains(channel.Channel))"
                                                                   @onchange="e => LogContainerChanged(channel.Channel, e)"/> @channel.Channel
                        </label>
                    }
                }
            </div>
        }
    </div>
    <p class="small text-muted">Web server includes Azure application console output. Azure platform/system selects
        platform and revision events.
        Other includes legacy output whose source cannot be identified from recorded metadata.</p>
    <label><input type="checkbox" checked="@Selection.IncludeMetrics" @onchange="MetricsChanged"/> Include recorded
        resource metrics</label>
    @if (Selection.IncludeMetrics)
    {
        @foreach (var container in MetricContainers)
        {
            <label class="assessment-container"><input type="checkbox"
                                                       checked="@(Selection.MetricContainers is null || Selection.MetricContainers.Contains(container))"
                                                       @onchange="e => MetricContainerChanged(container, e)"/> @container
            </label>
        }

        @if (MetricContainers.Count == 0)
        {
            <p class="small text-muted">No metric containers are recorded yet.</p>
        }
    }
    <p class="small">Only selected, bounded, redacted evidence and recorded configuration are sent. No diagnostic
        evidence means no provider call.</p>
</fieldset>
