@implements IAsyncDisposable
@inject IJSRuntime JS
<nav @ref="_navigation" class="project-section-tabs" aria-label="Project detail sections">
    <a href="#overview"><i class="bi bi-house" aria-hidden="true"></i>Overview</a>
    <a href="#logs"><i class="bi bi-terminal" aria-hidden="true"></i>Live Logs</a>
    <a href="#metrics"><i class="bi bi-bar-chart" aria-hidden="true"></i>Live Resource Utilization</a>
    <a href="#analytics"><i class="bi bi-graph-up" aria-hidden="true"></i>Project Analytics</a>
    <a href="#configuration"><i class="bi bi-gear" aria-hidden="true"></i>Configuration</a>
    <a href="#deployments"><i class="bi bi-clock-history" aria-hidden="true"></i>Deployment History</a>
</nav>

@code {

    /// <summary>Root for section navigation and the terminal shortcut.</summary>
    private ElementReference _navigation;

    /// <summary>Scoped browser module with no circuit business state.</summary>
    private IJSObjectReference? _module;

    /// <summary>Disposable browser listeners for this page instance.</summary>
    private IJSObjectReference? _controller;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/project-sections.js");
        _controller = await _module.InvokeAsync<IJSObjectReference>("attach", _navigation);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_controller is not null)
            {
                await _controller.InvokeVoidAsync("dispose");
                await _controller.DisposeAsync();
            }

            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

}
