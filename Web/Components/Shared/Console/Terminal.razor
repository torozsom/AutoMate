@*
    Hosts xterm output with bounded pre-initialization writes and component-owned browser cleanup.
*@
@namespace Web.Components.Shared.Console
@inject IJSRuntime JsRuntime
@inject ILogger<Terminal> Logger
@implements IAsyncDisposable

<div id="@Id" style="height: 100%; width: 100%; padding: 10px; box-sizing: border-box; overflow: hidden;"></div>
