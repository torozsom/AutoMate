@*
    Presents a theme action using the existing browser theme-storage contract.
*@
@namespace Web.Components.Shared.Console
@inject IJSRuntime Js
<button type="button" class="btn btn-outline-secondary" @onclick="ToggleAsync" aria-label="Toggle light and dark theme">
    <i class="bi bi-circle-half" aria-hidden="true"></i> Theme
</button>
