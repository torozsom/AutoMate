@*
    Hosts accessible dialog content with keyboard focus trapping and disposal-time focus restoration.
*@
@namespace Web.Components.Shared.Console
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject ILogger<ConsoleDialog> Logger

<div class="console-dialog-backdrop">
    <section class="console-dialog" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1"
             @ref="_root">
        <header class="console-dialog-header">
            <div><span class="page-eyebrow">@Eyebrow</span>
                <h2 id="@_titleId">@Title</h2></div>
            <button type="button" class="btn btn-outline-secondary" aria-label="Close dialog" @onclick="OnClose">×
            </button>
        </header>
        @if (_helpersUnavailable)
        {
            <p class="telemetry-notice" role="status">Keyboard helpers are unavailable. Use the Close button to dismiss
                this dialog.</p>
        }
        @ChildContent
    </section>
</div>
