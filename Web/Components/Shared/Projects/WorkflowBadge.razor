@*
    Presents remote workflow progress with an optional GitHub Actions link.
*@
@namespace Web.Components.Shared.Projects
<div class="workflow-banner @AlertClass">
    <div class="workflow-banner-copy">
        <i class="bi @IconClass fs-4 me-3"></i>
        <div>
            <h6 class="mb-0">GitHub Actions Workflow</h6>
            <small>@DisplayMessage</small>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(WorkflowUrl))
    {
        <a href="@WorkflowUrl" target="_blank" class="btn btn-sm workflow-banner-link">
            <i class="bi bi-box-arrow-up-right me-2"></i>Open workflow
        </a>
    }
</div>
