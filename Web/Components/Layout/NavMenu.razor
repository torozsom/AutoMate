<div class="nav-brand-row">
    <div class="brand-lockup">
        <a class="navbar-brand" href="">
            <span class="brand-mark" aria-hidden="true">A</span>
            <span>AutoMate</span>
        </a>
        <span class="brand-caption">Deployment console</span>
    </div>
</div>

<button type="button" class="mobile-nav-toggle" aria-label="Toggle navigation" aria-expanded="@_menuOpen"
        aria-controls="workspace-navigation" @ref="_menuToggle" @onclick="ToggleMenu">
    <i class="bi bi-list" aria-hidden="true"></i> Menu
</button>

<div id="workspace-navigation" class="nav-scrollable @(_menuOpen ? "nav-open" : null)" @onkeydown="HandleMenuKey">
    <nav class="nav flex-column h-100" aria-label="Primary">
        <div class="nav-section-label">Workspace</div>

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                <AuthorizeView Context="navOverview">
                    <Authorized>Overview</Authorized>
                    <NotAuthorized>Home</NotAuthorized>
                </AuthorizeView>
            </NavLink>
        </div>

        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="/login">
                        <span class="bi bi-person-fill-left-nav-menu" aria-hidden="true"></span> Login | Register
                    </NavLink>
                </div>
            </NotAuthorized>

            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="/dashboard" @onclick="CloseMenu">
                        <span class="bi bi-grid-3x3-nav-menu" aria-hidden="true"></span> Projects
                    </NavLink>
                </div>

                <div class="nav-section-label">Sources</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="/github-repos" @onclick="CloseMenu">
                        <span class="bi bi-github-repos-nav-menu" aria-hidden="true"></span> GitHub repositories
                    </NavLink>
                </div>

                @if (DeploymentCapabilities.LocalDeploymentsEnabled)
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="local-repos" @onclick="CloseMenu">
                            <span class="bi bi-folder2-open-nav-menu" aria-hidden="true"></span> Local repositories
                        </NavLink>
                    </div>
                }

                <div class="nav-section-label">Session</div>

                <div class="nav-item">
                    <form action="/api/auth/logout" method="post">
                        <AntiforgeryToken/>
                        <button type="submit" class="nav-link btn btn-link nav-action">
                            <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>

                <div class="nav-item mt-auto">
                    <button class="nav-link btn btn-link nav-action" @onclick="ToggleTheme">
                        <span class="bi @(_isDarkMode ? "bi-moon-fill-nav-menu" : "bi-sun-fill-nav-menu")"
                              aria-hidden="true"></span>
                        @(_isDarkMode ? "Dark Mode" : "Light Mode")
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>
