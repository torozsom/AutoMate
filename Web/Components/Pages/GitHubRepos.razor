@page "/github-repos"

<PageTitle>GitHub Repositories</PageTitle>

<div class="container mt-4">
    <h1>GitHub Repositories</h1>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_isErrorStatus ? "alert-warning" : "alert-success") alert-dismissible fade show mt-3"
             role="alert">
            @_statusMessage
            <button type="button" class="btn-close" @onclick="() => _statusMessage = null" aria-label="Close"></button>
        </div>
    }

    <AuthorizeView Context="authContext">
        <Authorized>
            <p>Welcome, @authContext.User.Identity?.Name!</p>

            @if (_isLoading)
            {
                <div class="spinner-border text-primary" role="status"></div>
            }
            else if (_githubRepos != null && _githubRepos.Any())
            {
                <h3 class="mt-4">Here are your GitHub repositories:</h3>
                <div class="row mt-3">
                    @foreach (var repo in _githubRepos)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card h-100 shadow border-black border-1">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="bi @(repo.IsPrivate ? "bi-lock-fill text-danger" : "bi-globe text-success")"></i>
                                        @repo.Name
                                    </h5>
                                    <h6 class="card-subtitle mb-2 text-muted">@repo.Language</h6>
                                    <p class="card-text small text-muted">Updated
                                        at: @repo.UpdatedAt.ToString("yyyy. MM. dd.")</p>
                                    <a href="@repo.HtmlUrl" target="_blank" class="btn btn-sm btn-outline-dark">Show in
                                        GitHub</a>

                                    @if (repo.Language == "C#")
                                    {
                                        <button class="btn btn-sm btn-primary m-2"
                                                @onclick="() => SaveProjectAsync(repo)">Save
                                        </button>
                                    }

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (_isGitHubUser)
            {
                <div class="alert alert-warning">Could not find repositories or access expired.</div>
            }
            else
            {
                <div class="alert alert-info">You need to login with GitHub to access remote repositories.</div>
            }
        </Authorized>
        <NotAuthorized>
            <p>Please log in to access remote repositories!</p>
            <a href="/login" class="btn btn-primary">Login</a>
        </NotAuthorized>
    </AuthorizeView>
</div>
