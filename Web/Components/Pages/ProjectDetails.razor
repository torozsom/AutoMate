@page "/project/{ProjectId:guid}"
@using Core.Enums

<PageTitle>Project Details</PageTitle>

<div class="container project-details-page py-4">
    <div class="project-hero mb-4">
        <div class="project-hero-main">
            <div class="project-avatar" aria-hidden="true">
                @if (_app?.SourceType == SourceType.Remote)
                {
                    <i class="bi bi-github"></i>
                }
                else
                {
                    <i class="bi bi-folder2-open"></i>
                }
            </div>
            <div class="min-w-0">
                <div class="project-eyebrow">
                    <span>@(_app?.SourceType == SourceType.Remote ? "GitHub Repository" : "Local Workspace")</span>
                </div>
                <h1 class="project-title" title="@_app?.Name">@(_app?.Name ?? "Loading..")</h1>
            </div>
        </div>

        @if (_app is not null)
        {
            <div class="project-actions">
                @{ var isDeploying = IsDeploying(); }
                <button class="btn btn-success action-button" @onclick="DeployProjectAsync"
                        disabled="@(isDeploying || _isStopping)">
                    @if (isDeploying)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Deploying...</span>
                    }
                    else
                    {
                        <i class="bi bi-play-fill me-1"></i>
                        <span>Deploy</span>
                    }
                </button>
                <button class="btn btn-outline-danger action-button" @onclick="StopDeploymentAsync"
                        disabled="@(_isStopping || isDeploying)">
                    @if (_isStopping)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Stopping...</span>
                    }
                    else
                    {
                        <i class="bi bi-stop-fill me-1"></i>
                        <span>Stop</span>
                    }
                </button>
            </div>
        }
    </div>

    @RenderConfigurationForm()

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
        </div>
    }
    else if (_app is null)
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Project not found or you don't have access.
        </div>
    }
    else
    {
        <div class="project-overview mb-4">
            <div class="overview-tile">
                <div class="overview-icon overview-icon-status">
                    <i class="bi bi-activity"></i>
                </div>
                <div>
                    <div class="overview-label">Deployment</div>
                    <DeploymentBadge Status="@GetLatestStatus()" AdditionalClasses="fs-6"/>
                </div>
            </div>

            <div class="overview-tile overview-tile-wide">
                <div class="overview-icon">
                    <i class="bi bi-link-45deg"></i>
                </div>
                <div class="min-w-0">
                    <div class="overview-label">Source Path</div>
                    <div class="overview-value text-truncate" title="@_app.SourcePathOrUrl">
                        @_app.SourcePathOrUrl
                    </div>
                </div>
            </div>

            @if (_app.SourceType == SourceType.Local && _webHostPort > 0)
            {
                <div class="overview-tile">
                    <div class="overview-icon overview-icon-port">
                        <i class="bi bi-hdd-network"></i>
                    </div>
                    <div>
                        <div class="overview-label">Web Port</div>
                        <div class="overview-value">@_webHostPort</div>
                    </div>
                </div>
            }
        </div>

        @if (_app.SourceType == SourceType.Local && GetLatestStatus() == DeploymentStatus.Running && _webHostPort > 0)
        {
            <div class="live-launch mb-4">
                <div class="live-launch-copy">
                    <span class="live-dot" aria-hidden="true"></span>
                    <div>
                        <div class="live-title">Web App is Live</div>
                        <div class="live-subtitle">Local endpoint is ready for this deployment.</div>
                    </div>
                </div>
                <a href="http://localhost:@_webHostPort" target="_blank" class="btn btn-success live-link">
                    <i class="bi bi-box-arrow-up-right me-2"></i>http://localhost:@_webHostPort
                </a>
            </div>
        }

        @if (_app.SourceType == SourceType.Remote)
        {
            <WorkflowBadge Status="@GetLatestStatus()"
                           Message="@_workflowStatusMessage"
                           WorkflowUrl="@_workflowUrl"/>
        }

        <section class="monitoring-shell">
            <div class="monitoring-header">
                <div>
                    <div class="section-kicker">Runtime Monitoring</div>
                    <h2 class="monitoring-title">Logs and metrics</h2>
                </div>
                <div class="monitoring-state">
                    <span
                        class="state-dot @(GetLatestStatus() == DeploymentStatus.Running ? "state-dot-running" : "")"></span>
                    <span>@(GetLatestStatus()?.ToString() ?? "Not deployed")</span>
                </div>
            </div>

            @if (GetLatestStatus() == DeploymentStatus.Running && _metricContainerNames.Count > 0)
            {
                var currentContainer = _metricContainerNames[_currentMetricIndex];
                var metrics = _containerMetrics[currentContainer];
                <div class="metrics-panel mb-4">
                    <button class="btn metric-nav-button" @onclick="PreviousMetric"
                            aria-label="Previous container metrics">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div class="metrics-summary">
                        <div class="container-chip">
                            <span class="container-initial">@GetContainerInitial(currentContainer)</span>
                            <div class="min-w-0">
                                <div class="metric-label">Container</div>
                                <div class="container-name text-truncate"
                                     title="@currentContainer">@currentContainer</div>
                            </div>
                        </div>
                    </div>

                    <div class="metric-cards">
                        <div class="metric-card">
                            <div class="metric-card-head">
                                <span>CPU</span>
                                <i class="bi bi-cpu"></i>
                            </div>
                            <div class="metric-value">@metrics.Cpu</div>
                            <div class="metric-track" aria-hidden="true">
                                <span style="@GetMetricTrackStyle(metrics.Cpu, false)"></span>
                            </div>
                        </div>

                        <div class="metric-card">
                            <div class="metric-card-head">
                                <span>Memory</span>
                                <i class="bi bi-memory"></i>
                            </div>
                            <div class="metric-value">@metrics.Memory</div>
                            <div class="metric-track" aria-hidden="true">
                                <span style="@GetMetricTrackStyle(metrics.Memory, true)"></span>
                            </div>
                        </div>
                    </div>

                    <button class="btn metric-nav-button" @onclick="NextMetric" aria-label="Next container metrics">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            }
            else
            {
                <div class="metrics-empty mb-4">
                    <i class="bi bi-speedometer2"></i>
                    <span>Metrics will appear when containers are running.</span>
                </div>
            }

            <div class="terminal-panel">
                <div class="terminal-panel-header">
                    <ul class="nav nav-pills terminal-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="@GetBuildTabClass()" type="button" role="tab"
                                    @onclick='() => SetActiveTab("build")'>
                                <i class="bi bi-hammer me-1"></i> Build Logs
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="@GetWebTabClass()" type="button" role="tab"
                                    @onclick='() => SetActiveTab("web")'>
                                <i class="bi bi-globe me-1"></i> Web App
                            </button>
                        </li>

                        @foreach (var db in GetDatabaseTabs())
                        {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @GetTabClass(db.TabId)" type="button" role="tab"
                                        @onclick="() => SetActiveTab(db.TabId)">
                                    <i class="bi bi-database me-1"></i> @db.DisplayName
                                </button>
                            </li>
                        }
                    </ul>
                </div>
                <div class="terminal-panel-body">
                    <div style="@GetBuildTerminalStyle()">
                        <Terminal @ref="_buildTerminal" Id="build-logs-term"
                                  OnReady='() => OnTerminalReady(_buildTerminal, "Build")'/>
                    </div>

                    <div style="@GetWebTerminalStyle()">
                        <Terminal @ref="_webTerminal" Id="web-logs-term"
                                  OnReady='() => OnTerminalReady(_webTerminal, "Web App")'/>
                    </div>

                    @foreach (var db in GetDatabaseTabs())
                    {
                        var databaseTerminalStyle = GetDatabaseTerminalStyle(db.TabId);
                        <div style="@databaseTerminalStyle">
                            <Terminal @ref="_dbTerminals[db.TabId]"
                                      Id="@($"term-{db.TabId}")"
                                      OnReady='() => OnDbTerminalReady(db.TabId, db.DisplayName)'/>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>
