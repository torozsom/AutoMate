@page "/project/{ProjectId:guid}"
@using Domain.Entities
@using Domain.Enums

<PageTitle>Project Details</PageTitle>

<div class="container page-shell project-details-page">
    @RenderConfigurationForm()

    @if (_isLoading)
    {
        <div class="project-loading" role="status" aria-live="polite">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="page-description">Loading project details...</p>
        </div>
    }
    else if (_app is null)
    {
        <div class="auth-state">
            <div class="auth-state-icon">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            </div>
            <h2>Project unavailable</h2>
            <p class="page-description">Project not found or you do not have access.</p>
        </div>
    }
    else
    {
        var isDeploying = IsDeploying();
        var queueState = DeploymentJobQueue.GetProjectState(ProjectId);
        var isQueued = (queueState.QueuedDeployments > 0 && queueState.ActiveDeployments == 0) ||
                       _cloudRunReceipt?.Phase == CloudRunPhase.Queued;
        var isStopping = _isStopping || queueState.QueuedStops > 0 || queueState.ActiveStops > 0;
        var latestStatus = GetLatestStatus();
        var latestDeployment = GetLatestDeployment();
        var primaryWebProject = GetPrimaryWebProject();
        var primaryConfiguration = primaryWebProject?.Configuration;
        var sourceLabel = _app.SourceType == SourceType.Remote ? "GitHub" : "Local";
        var platformLabel = _app.SourceType == SourceType.Remote ? "Azure Container Apps" : "Docker Compose";
        var branchLabel = _app.SourceType == SourceType.Remote ? "GitHub repository" : "workspace";
        var webProjectCount = _app.CsProjects.Count(csp => csp.IsWebProject);
        var subProjectCount = _app.CsProjects.Count;
        var databaseCount = _databaseTabs.Count();
        var allDeployments = _app.CsProjects.SelectMany(p => p.Deployments).OrderBy(d => d.CreatedAt).ToList();
        var recentDeployments = allDeployments.OrderByDescending(d => d.CreatedAt).ThenByDescending(d => d.Id).Skip(_deploymentPage * 6).Take(6).ToList();

        <section class="project-console @GetProjectSourceClass(_app.SourceType)">
            <header class="project-console-header">
                <div class="project-identity">
                    <div class="project-breadcrumb">AutoMate / @_app.Name</div>
                    <div class="project-subtitle">
                        <span>@sourceLabel</span>
                        <span aria-hidden="true">·</span>
                        <span>@branchLabel</span>
                        <span aria-hidden="true">·</span>
                        <span>@platformLabel</span>
                    </div>
                </div>

                <div class="project-status-cluster">
                    <DeploymentBadge Status="@latestStatus"/>
                    <div class="project-actions">
                        <button class="btn btn-success action-button action-button-deploy" @onclick="DeployProjectAsync"
                                disabled="@(isDeploying || isStopping)">
                            @if (isDeploying)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>@(isQueued ? "Queued..." : "Deploying...")</span>
                            }
                            else
                            {
                                <i class="bi bi-play-fill" aria-hidden="true"></i>
                                <span>Deploy</span>
                            }
                        </button>

                        <button class="btn btn-outline-danger action-button" @onclick="StopDeploymentAsync"
                                title="@(_app.SourceType == SourceType.Local ? "Stop local deployment" : "Stop cloud deployments in your cloud provider's portal")"
                                disabled="@(isStopping || isDeploying || _app.SourceType != SourceType.Local)">
                            @if (isStopping)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>@(queueState.QueuedStops > 0 && queueState.ActiveStops == 0 ? "Queued..." : "Stopping...")</span>
                            }
                            else
                            {
                                <i class="bi bi-stop-fill" aria-hidden="true"></i>
                                <span>Stop</span>
                            }
                        </button>
                    </div>
                </div>
            </header>

            <ProjectSectionNavigation/>

            <div class="project-console-body">
                <section id="overview" class="console-section" aria-labelledby="overview-title">
                    <div class="section-heading">
                        <div>
                            <div class="section-kicker">Overview</div>
                            <h2 id="overview-title">Project status</h2>
                        </div>
                    </div>

                    <dl class="project-overview-stats">
                        <div>
                            <dt>Saved to dashboard</dt>
                            <dd>@FormatTimestamp(_app.CreatedAt)</dd>
                        </div>
                        <div>
                            <dt>First deployment</dt>
                            <dd>@FormatTimestamp(allDeployments.FirstOrDefault()?.CreatedAt)</dd>
                        </div>
                        <div>
                            <dt>Total deployments</dt>
                            <dd>@allDeployments.Count</dd>
                        </div>
                        <div>
                            <dt>Successful</dt>
                            <dd>@allDeployments.Count(d => d.Outcome == DeploymentOutcome.Succeeded)</dd>
                        </div>
                        <div>
                            <dt>Failed</dt>
                            <dd>@allDeployments.Count(d => d.Outcome == DeploymentOutcome.Failed)</dd>
                        </div>
                        <div>
                            <dt>Pending / unknown</dt>
                            <dd>@allDeployments.Count(d => d.Outcome == DeploymentOutcome.Unknown)</dd>
                        </div>
                    </dl>
                    <div class="overview-layout">
                        <article class="detail-panel detail-panel-primary">
                            <div class="panel-header">
                                <h3>Deployment</h3>
                                <DeploymentBadge Status="@latestStatus"/>
                            </div>
                            <dl class="detail-list">
                                <div>
                                    <dt>Status</dt>
                                    <dd>@(latestStatus?.ToString() ?? "Not deployed")</dd>
                                </div>
                                <div>
                                    <dt>Last deployed</dt>
                                    <dd>@FormatTimestamp(latestDeployment?.CreatedAt)</dd>
                                </div>
                                <div>
                                    <dt>Image</dt>
                                    <dd class="text-truncate"
                                        title="@latestDeployment?.ImageTag">@(latestDeployment?.ImageTag ?? "None")</dd>
                                </div>
                                <div>
                                    <dt>Revision</dt>
                                    <dd class="text-truncate"
                                        title="@GetRevisionLabel(latestDeployment)">@GetRevisionLabel(latestDeployment)</dd>
                                </div>
                            </dl>
                        </article>

                        <article class="detail-panel">
                            <div class="panel-header">
                                <h3>Infrastructure</h3>
                                <span class="source-pill">@platformLabel</span>
                            </div>
                            <dl class="detail-list">
                                <div>
                                    <dt>Provider</dt>
                                    <dd>@GetProviderLabel()</dd>
                                </div>
                                <div>
                                    <dt>Region / endpoint</dt>
                                    <dd>@GetRegionOrEndpoint(primaryConfiguration)</dd>
                                </div>
                                <div>
                                    <dt>Web apps</dt>
                                    <dd>@webProjectCount / @subProjectCount</dd>
                                </div>
                                <div>
                                    <dt>Databases</dt>
                                    <dd>@databaseCount</dd>
                                </div>
                            </dl>
                        </article>
                    </div>

                    <div class="source-path-panel">
                        <div class="section-kicker">Source</div>
                        <div class="source-path-row" title="@_app.SourcePathOrUrl">
                            <i class="bi bi-link-45deg" aria-hidden="true"></i>
                            @if (GitHubRepositoryUrlParser.TryParse(_app.SourcePathOrUrl, out var repository))
                            {
                                <a class="text-truncate"
                                   href="@($"https://github.com/{repository.Owner}/{repository.Name}")" target="_blank"
                                   rel="noopener noreferrer">@_app.SourcePathOrUrl</a>
                            }
                            else
                            {
                                <span class="text-truncate">@_app.SourcePathOrUrl</span>
                            }
                        </div>
                    </div>
                </section>

                <section id="logs" class="console-section" aria-labelledby="logs-title">
                    <TelemetryPreferences ProjectId="ProjectId"/>
                    <div class="section-heading">
                        <div>
                            <div class="section-kicker">Live logs</div>
                            <h2 id="logs-title">Runtime output</h2>
                        </div>
                    </div>

                    <div class="terminal-panel">
                        <div class="terminal-panel-header">
                            <ul class="nav nav-pills terminal-tabs" role="tablist">
                                @if (_app.SourceType == SourceType.Remote)
                                {
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @GetTabClass("github-actions")" type="button" role="tab"
                                                @onclick='() => SetActiveTab("github-actions")'>
                                            <i class="bi bi-github" aria-hidden="true"></i>
                                            <span>GitHub Actions</span>
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @GetTabClass("azure-web")" type="button" role="tab"
                                                @onclick='() => SetActiveTab("azure-web")'>
                                            <i class="bi bi-microsoft" aria-hidden="true"></i>
                                            <span>Azure Web</span>
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @GetTabClass("azure-system")" type="button" role="tab"
                                                @onclick='() => SetActiveTab("azure-system")'>
                                            <i class="bi bi-gear" aria-hidden="true"></i>
                                            <span>Azure System</span>
                                        </button>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item" role="presentation">
                                        <button class="@GetBuildTabClass()" type="button" role="tab"
                                                @onclick='() => SetActiveTab("build")'>
                                            <i class="bi bi-hammer" aria-hidden="true"></i>
                                            <span>Build logs</span>
                                        </button>
                                    </li>

                                    <li class="nav-item" role="presentation">
                                        <button class="@GetWebTabClass()" type="button" role="tab"
                                                @onclick='() => SetActiveTab("web")'>
                                            <i class="bi bi-globe" aria-hidden="true"></i>
                                            <span>Web app</span>
                                        </button>
                                    </li>

                                    @foreach (var db in GetDatabaseTabs())
                                    {
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link @GetTabClass(db.TabId)" type="button" role="tab"
                                                    @onclick="() => SetActiveTab(db.TabId)">
                                                <i class="bi bi-database" aria-hidden="true"></i>
                                                <span>@db.DisplayName</span>
                                            </button>
                                        </li>
                                    }
                                }
                            </ul>
                            <a href="#ai-analysis" class="terminal-ai-shortcut" aria-label="Go to AI Analysis"
                               title="AI Analysis">
                                <i class="bi bi-stars" aria-hidden="true"></i><span>AI</span>
                            </a>
                        </div>

                        <div class="terminal-panel-body">
                            @if (_app.SourceType == SourceType.Remote)
                            {
                                <div style="@GetTerminalStyle("github-actions")">
                                    <Terminal @ref="_githubActionsTerminal" Id="github-actions-term"
                                              OnReady='() => OnTerminalReady(_githubActionsTerminal, "GitHub Actions")'/>
                                </div>
                                <div style="@GetTerminalStyle("azure-web")">
                                    <Terminal @ref="_azureWebTerminal" Id="azure-web-term"
                                              OnReady='() => OnTerminalReady(_azureWebTerminal, "Azure Web")'/>
                                </div>
                                <div style="@GetTerminalStyle("azure-system")">
                                    <Terminal @ref="_azureSystemTerminal" Id="azure-system-term"
                                              OnReady='() => OnTerminalReady(_azureSystemTerminal, "Azure System")'/>
                                </div>
                            }
                            else
                            {
                                <div style="@GetBuildTerminalStyle()">
                                    <Terminal @ref="_buildTerminal" Id="build-logs-term"
                                              OnReady='() => OnTerminalReady(_buildTerminal, "Build")'/>
                                </div>

                                <div style="@GetWebTerminalStyle()">
                                    <Terminal @ref="_webTerminal" Id="web-logs-term"
                                              OnReady='() => OnTerminalReady(_webTerminal, "Web App")'/>
                                </div>

                                @foreach (var db in GetDatabaseTabs())
                                {
                                    var databaseTerminalStyle = GetDatabaseTerminalStyle(db.TabId);
                                    <div style="@databaseTerminalStyle">
                                        <Terminal @ref="_dbTerminals[db.TabId]"
                                                  Id="@($"term-{db.TabId}")"
                                                  OnReady='() => OnDbTerminalReady(db.TabId, db.DisplayName)'/>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </section>

                <section id="metrics" class="console-section" aria-labelledby="metrics-title">
                    <div class="section-heading">
                        <div>
                            <div class="section-kicker">Live Resource Utilization</div>
                            <h2 id="metrics-title">Live Resource Utilization</h2>
                        </div>
                    </div>


                    <h3 class="h6">Container utilization</h3>
                    @if (latestStatus == DeploymentStatus.Running && _metricContainerNames.Count > 0)
                    {
                        @if (_showSavedMetricNotice)
                        {
                            <p role="status">Showing recent saved samples while waiting for live metrics.</p>
                        }

                        var currentContainer = _metricContainerNames[_currentMetricIndex];
                        var metrics = _containerMetrics[currentContainer];

                        <div class="metrics-panel">
                            <button class="btn metric-nav-button" @onclick="PreviousMetric"
                                    aria-label="Previous container metrics">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            </button>

                            <div class="metrics-summary">
                                <div class="container-chip">
                                    <span class="container-initial">@GetContainerInitial(currentContainer)</span>
                                    <div class="min-w-0">
                                        <div class="metric-label">Container</div>
                                        <div class="container-name text-truncate"
                                             title="@currentContainer">@currentContainer</div>
                                    </div>
                                </div>
                            </div>

                            <div class="metric-cards">
                                <div class="metric-card">
                                    <div class="metric-card-head">
                                        <span>CPU</span>
                                        <i class="bi bi-cpu" aria-hidden="true"></i>
                                    </div>
                                    <div class="metric-value">@metrics.Cpu</div>
                                    <div class="metric-track" aria-hidden="true">
                                        <span style="@GetMetricTrackStyle(metrics.Cpu, false)"></span>
                                    </div>
                                </div>

                                <div class="metric-card">
                                    <div class="metric-card-head">
                                        <span>Memory</span>
                                        <i class="bi bi-memory" aria-hidden="true"></i>
                                    </div>
                                    <div class="metric-value">@metrics.Memory</div>
                                    <div class="metric-track" aria-hidden="true">
                                        <span style="@GetMetricTrackStyle(metrics.Memory, true)"></span>
                                    </div>
                                </div>
                            </div>

                            <button class="btn metric-nav-button" @onclick="NextMetric"
                                    aria-label="Next container metrics">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="metrics-empty">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            <span>Metrics will appear when containers are running.</span>
                        </div>
                    }
                </section>

                <section id="analytics" class="console-section" aria-labelledby="analytics-title">
                    <h2 id="analytics-title">Project Analytics</h2>
                    <ProjectTelemetrySummary ProjectId="ProjectId" UserId="_currentUserId"/>
                </section>

                <section id="ai-analysis" class="console-section ai-analysis-accent"
                         aria-labelledby="ai-analysis-title">
                    <h2 id="ai-analysis-title">AI Analysis</h2>
                    <DeploymentAnalysisSection OwnerId="_currentUserId" ProjectId="ProjectId"
                                               DeploymentId="@(latestDeployment?.Id)"
                                               CsProjectId="@(latestDeployment?.CsProjectId ?? Guid.Empty)"
                                               Consented="@(_app.CsProjects.FirstOrDefault(p => p.Id == latestDeployment?.CsProjectId)?.Configuration?.AiDiagnosticEgressConsented == true)"/>
                </section>

                <section id="configuration" class="console-section" aria-labelledby="configuration-title">
                    <div class="section-heading">
                        <div>
                            <div class="section-kicker">Configuration</div>
                            <h2 id="configuration-title">Deployment settings</h2>
                        </div>
                        <button class="btn btn-outline-secondary" @onclick="DeployProjectAsync"
                                disabled="@(isDeploying || _isStopping)">
                            <i class="bi bi-sliders" aria-hidden="true"></i>
                            <span>Configure deploy</span>
                        </button>
                    </div>

                    <DeploymentConfigurationDetails Deployment="latestDeployment"/>
                    <p class="telemetry-muted">Recorded settings belong to the latest deployment. Configure deploy
                        changes settings for the next deployment.</p>
                </section>

                <section id="deployments" class="console-section" aria-labelledby="deployments-title">
                    <div class="section-heading">
                        <div>
                            <div class="section-kicker">Deployments</div>
                            <h2 id="deployments-title">Deployment history</h2>
                        </div>
                        <div class="monitoring-state">
                            <span
                                class="state-dot @(latestStatus == DeploymentStatus.Running ? "state-dot-running" : "")"
                                aria-hidden="true"></span>
                            <span>@(latestStatus?.ToString() ?? "Not deployed")</span>
                        </div>
                    </div>

                    <div class="deployment-list">
                        @if (recentDeployments.Count == 0)
                        {
                            <div class="metrics-empty deployment-empty">
                                <i class="bi bi-rocket-takeoff" aria-hidden="true"></i>
                                <span>No deployments yet. Configure and deploy this project to start the history.</span>
                            </div>
                        }
                        else
                        {
                            <table class="table console-table responsive-inventory">
                                <caption class="visually-hidden">Deployment history for this project</caption>
                                <thead>
                                <tr>
                                    <th scope="col">Deployment</th>
                                    <th scope="col">Outcome</th>
                                    <th scope="col">Runtime</th>
                                    <th scope="col">Started UTC</th>
                                    <th scope="col">Details</th>
                                </tr>
                                </thead>
                                <tbody>@foreach (var deployment in recentDeployments)
                                {
                                    <tr>
                                        <td data-label="Deployment">
                                            <strong>@(deployment.CsProject?.Name ?? _app.Name)</strong><small
                                                class="console-subtext">@deployment.Id.ToString("N")[..8]</small></td>
                                        <td data-label="Outcome">@deployment.Outcome</td>
                                        <td data-label="Runtime">
                                            <DeploymentBadge Status="@deployment.Status"/>
                                        </td>
                                        <td data-label="Started UTC">@deployment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td data-label="Details"><a
                                                href="@($"/project/{ProjectId}/deployment/{deployment.Id}")">View
                                                Details</a></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                    </div>
                    <div class="history-pagination">
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(_deploymentPage == 0)"
                                @onclick="() => _deploymentPage--">Newer deployments
                        </button>
                        <span>Page @(_deploymentPage + 1)</span>
                        <button class="btn btn-sm btn-outline-secondary"
                                disabled="@((_deploymentPage + 1) * 6 >= allDeployments.Count)"
                                @onclick="() => _deploymentPage++">Older deployments
                        </button>
                    </div>
                </section>
            </div>
        </section>
    }
</div>

@code {

    /// <summary>Bounded six-item deployment history page.</summary>
    private int _deploymentPage;


    private static string GetProjectSourceClass(SourceType sourceType)
    {
        return sourceType == SourceType.Remote ? "project-console-remote" : "project-console-local";
    }

    private CsProject? GetPrimaryWebProject()
    {
        return _app?.CsProjects.FirstOrDefault(csp => csp.IsWebProject);
    }

    private Deployment? GetLatestDeployment()
    {
        return _app?.CsProjects
            .SelectMany(csp => csp.Deployments)
            .MaxBy(deployment => deployment.CreatedAt);
    }

    private IEnumerable<Deployment> GetRecentDeployments()
    {
        return _app?.CsProjects
                   .SelectMany(csp => csp.Deployments)
                   .OrderByDescending(deployment => deployment.CreatedAt)
                   .Take(6)
               ?? [];
    }

    private static string FormatTimestamp(DateTimeOffset? timestamp)
    {
        return timestamp?.ToString("yyyy. MM. dd. HH:mm") ?? "Never";
    }

    private static string GetRevisionLabel(Deployment? deployment)
    {
        if (!string.IsNullOrWhiteSpace(deployment?.CloudContainerRevision))
            return deployment.CloudContainerRevision;

        if (!string.IsNullOrWhiteSpace(deployment?.DockerContainerId))
            return deployment.DockerContainerId.Length <= 12
                ? deployment.DockerContainerId
                : deployment.DockerContainerId[..12];

        return "None";
    }

    private string GetProviderLabel()
    {
        return _app?.SourceType == SourceType.Remote ? "Azure" : "Docker";
    }

    private string GetRegionOrEndpoint(Configuration? configuration)
    {
        if (_app?.SourceType == SourceType.Remote)
            return string.IsNullOrWhiteSpace(configuration?.CloudAzureRegion)
                ? "Configured during deploy"
                : configuration.CloudAzureRegion;

        return _webHostPort > 0 ? $"localhost:{_webHostPort}" : "Assigned during deploy";
    }

    private static string GetDeploymentMeta(Deployment deployment)
    {
        if (!string.IsNullOrWhiteSpace(deployment.CloudAppUrl))
            return deployment.CloudAppUrl;

        if (!string.IsNullOrWhiteSpace(deployment.ImageTag))
            return deployment.ImageTag;

        if (!string.IsNullOrWhiteSpace(deployment.DockerContainerId))
            return deployment.DockerContainerId;

        return deployment.Status == DeploymentStatus.Failed
            ? "Failed before an artifact was recorded; see deployment logs"
            : "Deployment artifact not yet recorded";
    }

}
