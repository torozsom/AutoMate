@page "/project/{ProjectId:guid}"
@using Core.Enums

<PageTitle>Project Details</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <h2 class="mb-0">
                @if (_app?.SourceType == SourceType.Remote)
                {
                    <i class="bi bi-github me-2"></i>
                }
                else
                {
                    <i class="bi bi-folder2-open me-2 text-warning"></i>
                }
                @(_app?.Name ?? "Loading...")
            </h2>
        </div>

        @if (_app is not null)
        {
            <div class="d-flex gap-2">
                @{ var isDeploying = IsDeploying(); }
                <button class="btn btn-success" @onclick="DeployProjectAsync" disabled="@(isDeploying || _isStopping)">
                    @if (isDeploying)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Deploying...</span>
                    }
                    else
                    {
                        <i class="bi bi-play-fill me-1"></i>
                        <span>Deploy</span>
                    }
                </button>
                <button class="btn btn-outline-danger" @onclick="StopDeploymentAsync"
                        disabled="@(_isStopping || isDeploying)">
                    @if (_isStopping)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Stopping...</span>
                    }
                    else
                    {
                        <i class="bi bi-stop-fill me-1"></i>
                        <span>Stop</span>
                    }
                </button>
            </div>
        }
    </div>

    @if (_showConfigModal && _currentDeployConfig is not null && _selectedProjectPath is not null)
    {
        <ConfigurationForm
            Config="@_currentDeployConfig"
            ProjectPath="@_selectedProjectPath"
            OnCancel="@HideConfigModal"
            OnDeployConfirmed="@ExecuteDeploymentAsync"/>
    }

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
        </div>
    }
    else if (_app is null)
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Project not found or you don't have access.
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card bg-dark-subtle border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Status</h6>
                        <DeploymentBadge Status="@GetLatestStatus()" AdditionalClasses="fs-6"/>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card bg-dark-subtle border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Source Path</h6>
                        <p class="mb-0 font-monospace text-truncate" title="@_app.SourcePathOrUrl">
                            @_app.SourcePathOrUrl
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @if (_app.SourceType == SourceType.Remote)
        {
            <WorkflowBadge Status="@GetLatestStatus()"
                           Message="@_workflowStatusMessage"
                           WorkflowUrl="@_workflowUrl"/>
        }

        @if (GetLatestStatus() == DeploymentStatus.Running && _exposedPort > 0)
        {
            <div class="alert alert-success shadow-sm d-flex align-items-center justify-content-between mb-4"
                 style="border-radius: 15px;">
                <div class="d-flex align-items-center">
                    <i class="bi bi-rocket-takeoff-fill fs-4 me-3"></i>
                    <div>
                        <h6 class="mb-0">Web App is Live!</h6>
                        <small class="text-muted">You can access your deployed project by clicking the link
                            here:</small>
                    </div>
                </div>
                <a href="http://localhost:@_exposedPort" target="_blank" class="btn btn-success fw-bold px-4 py-2"
                   style="border-radius: 10px;">
                    <i class="bi bi-box-arrow-up-right me-2"></i>http://localhost:@_exposedPort
                </a>
            </div>
        }

        <!-- Metrics Card -->
        @if (GetLatestStatus() == DeploymentStatus.Running && _metricContainerNames.Count > 0)
        {
            var currentContainer = _metricContainerNames[_currentMetricIndex];
            var metrics = _containerMetrics[currentContainer];
            <div class="card bg-dark-subtle border-secondary border-opacity-25 shadow-sm mb-4"
                 style="border-radius: 15px;">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <button class="btn px-2 py-1 border-0" @onclick="PreviousMetric">
                        <i class="bi bi-arrow-left-square-fill fs-5"></i>
                    </button>
                    <div class="text-center mx-3 flex-grow-1">
                        <h6 class="text-muted text-uppercase text-truncate mb-3" style="font-size: 0.85rem;"><i
                                class="bi bi-box me-1"></i> @currentContainer</h6>
                        <div class="d-flex justify-content-center gap-4">
                            <div>
                                <span class="small d-block mb-1">CPU</span>
                                <span class="fw-bold">@metrics.Cpu</span>
                            </div>
                            <div class="border-start border-secondary opacity-50 mx-2"></div>
                            <div>
                                <span class="small d-block mb-1">Memory</span>
                                <span class="fw-bold">@metrics.Memory</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn px-2 py-1 border-0" @onclick="NextMetric">
                        <i class="bi bi-arrow-right-square-fill fs-5"></i>
                    </button>
                </div>
            </div>
        }

        <div class="card shadow-sm border-secondary border-opacity-25 bg-dark">
            <div class="card-header border-bottom border-secondary border-opacity-25 pt-3 pb-0">
                <ul class="nav nav-tabs border-0" role="tablist">
                    <!-- Build Logs -->
                    <li class="nav-item" role="presentation">
                        <button class="@GetBuildTabClass()" type="button" role="tab"
                                @onclick='() => SetActiveTab("build")'>
                            <i class="bi bi-hammer me-1"></i> Build Logs
                        </button>
                    </li>

                    <!-- Web App -->
                    <li class="nav-item" role="presentation">
                        <button class="@GetWebTabClass()" type="button" role="tab"
                                @onclick='() => SetActiveTab("web")'>
                            <i class="bi bi-globe me-1"></i> Web App
                        </button>
                    </li>

                    @foreach (var db in GetDatabaseTabs())
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @GetTabClass(db.TabId)" type="button" role="tab"
                                    @onclick="() => SetActiveTab(db.TabId)">
                                <i class="bi bi-database me-1"></i> @db.DisplayName
                            </button>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-body p-0"
                 style="height: 470px; background-color: #1e1e1e; overflow: hidden; position: relative;">

                <!-- Build Logs Terminal -->
                <div style="@GetBuildTerminalStyle()">
                    <Terminal @ref="_buildTerminal" Id="build-logs-term"
                              OnReady='() => OnTerminalReady(_buildTerminal, "Build")'/>
                </div>

                <!-- Web App Terminal -->
                <div style="@GetWebTerminalStyle()">
                    <Terminal @ref="_webTerminal" Id="web-logs-term"
                              OnReady='() => OnTerminalReady(_webTerminal, "Web App")'/>
                </div>

                <!-- Database Terminals -->
                @foreach (var db in GetDatabaseTabs())
                {
                    var databaseTerminalStyle = GetDatabaseTerminalStyle(db.TabId);
                    <div style="@databaseTerminalStyle">
                        <Terminal @ref="_dbTerminals[db.TabId]"
                                  Id="@($"term-{db.TabId}")"
                                  OnReady='() => OnDbTerminalReady(db.TabId, db.DisplayName)'/>
                    </div>
                }
            </div>
        </div>
    }
</div>