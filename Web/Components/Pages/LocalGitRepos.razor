@page "/local-repos"

@using Microsoft.AspNetCore.Components.Authorization
@using Core.Entities

@inject AuthenticationStateProvider AuthStateProvider


<PageTitle>Local Git Repositories</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Local Git Repositories</h1>
        <button class="btn btn-primary">
            <i class="bi bi-search"></i> Search On Device
        </button>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="alert alert-info shadow-sm">
                <i class="bi bi-info-circle-fill me-2"></i>
                You will be able to see all the Git repositories on your device, and manage them directly from AutoMate.
            </div>

            <div class="text-center mt-5 text-muted">
                <i class="bi bi-folder2-open display-1"></i>
                <p class="mt-3 lead">Click on the button above to start searching for Git repos locally.</p>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning">
                To access this page, please <a href="/login" class="alert-link">log in</a>.
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>


