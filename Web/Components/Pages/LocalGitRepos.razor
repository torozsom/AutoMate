@page "/local-repos"

<PageTitle>Local Git Repositories</PageTitle>

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-5">
            <h1>Local Git Repositories</h1>
        </div>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="alert @(_isErrorStatus ? "alert-warning" : "alert-success") alert-dismissible fade show mt-3"
                 role="alert">
                @_statusMessage
                <button type="button" class="btn-close" @onclick="() => _statusMessage = null"
                        aria-label="Close"></button>
            </div>
        }

        <div class="col-md-7">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-folder2"></i></span>
                <input type="text" class="form-control" placeholder="E.g.: C:\Dev or /home/user/projects"
                       @bind="_searchPath" @bind:event="oninput" @onkeyup="HandleKeyUp"/>
                <button class="btn btn-primary" @onclick="StartScan"
                        disabled="@(string.IsNullOrWhiteSpace(_searchPath) || _isScanning)">
                    @if (_isScanning)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Scanning...</span>
                    }
                    else
                    {
                        <i class="bi bi-search me-1"></i>
                        <span>Start scan</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <AuthorizeView>
        <Authorized>

            @if (_hasScanned && !_isScanning)
            {
                if (_localProjects == null || !_localProjects.Any())
                {
                    <div class="alert alert-warning text-center mt-4">
                        <i class="bi bi-exclamation-triangle display-4"></i>
                        <p class="mt-3 lead">We could not find any Git projects within the given folder.
                            <strong>@_lastSearchedPath</strong></p>
                    </div>
                }
                else
                {
                    <h3 class="mt-4 mb-3">Projects found: @_localProjects.Count</h3>

                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        @foreach (var project in _localProjects)
                        {
                            <div class="card mb-3 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-folder-fill text-warning me-2"></i> @project.Name
                                    </h5>
                                    <small class="text-muted">@project.Path</small>
                                </div>
                                <div class="card-body p-0">
                                    <ul class="list-group list-group-flush">
                                        @foreach (var subProj in project.CsProjects)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                                                <div>
                                                    <i class="bi bi-filetype-cs me-2 text-primary"></i> @subProj.Name
                                                    @if (subProj.IsWebProject)
                                                    {
                                                        <span
                                                            class="badge bg-success bg-opacity-10 text-success border border-success ms-2">Web App</span>
                                                    }
                                                    else
                                                    {
                                                        <span
                                                            class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary ms-2">Library</span>
                                                    }
                                                </div>
                                                @if (subProj.IsWebProject)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => SaveProjectAsync(project, subProj)">
                                                        Select
                                                    </button>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else if (!_isScanning)
            {
                <div class="text-center mt-5 text-muted">
                    <i class="bi bi-folder2-open display-1"></i>
                    <p class="mt-3 lead">Choose a folder and click on the button above!</p>
                </div>
            }

        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning">
                Please log in for scanning your local folders for Git projects.
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
