@page "/local-repos"

<PageTitle>Local Git Repositories</PageTitle>

<div class="container page-shell local-repos-page">
    <div class="page-header">
        <div class="page-header-copy">
            <div class="page-eyebrow">Local sources</div>
            <h1>Local Git repositories</h1>
            <p class="page-description">Scan a filesystem workspace for Git repositories and deployable C# web projects.</p>
        </div>
    </div>

    <section class="scan-panel" aria-labelledby="scan-panel-title">
        <div class="scan-panel-copy">
            <div class="scan-panel-icon">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
            </div>
            <div>
                <h2 id="scan-panel-title">Scan workspace</h2>
                <p class="page-description">Choose a parent folder. AutoMate will inspect Git repositories below it and surface supported .NET web apps.</p>
            </div>
        </div>

        <div class="scan-form">
            <label class="scan-label" for="local-scan-path">Folder path</label>
            <div class="input-group scan-input-group">
                <span class="input-group-text">
                    <i class="bi bi-folder2" aria-hidden="true"></i>
                </span>
                <input id="local-scan-path"
                       type="text"
                       class="form-control"
                       placeholder="E.g.: C:\Dev or /home/user/projects"
                       @bind="_searchPath"
                       @bind:event="oninput"
                       @onkeyup="HandleKeyUp"/>

                <button class="btn btn-primary" @onclick="StartScanAsync" disabled="@IsScanButtonDisabled">
                    @if (_isScanning)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Scanning...</span>
                    }
                    else
                    {
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <span>Start scan</span>
                    }
                </button>
            </div>
            <div class="scan-hint">Press Enter to scan after entering a path.</div>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_isErrorStatus ? "alert-warning" : "alert-success") alert-dismissible fade show shadow-sm local-status-alert"
             role="alert">
            <i class="bi @(_isErrorStatus ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
            <span>@_statusMessage</span>
            <button type="button" class="btn-close" @onclick="ClearStatusMessage" aria-label="Close"></button>
        </div>
    }

    <AuthorizeView>
        <Authorized>
            @if (_isScanning)
            {
                <div class="scan-state" role="status" aria-live="polite">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Scanning...</span>
                    </div>
                    <div>
                        <h2>Scanning local workspace</h2>
                        <p class="page-description">Inspecting Git repositories and C# project files under <strong>@_lastSearchedPath</strong>.</p>
                    </div>
                </div>
            }
            else if (_hasScanned)
            {
                if (_localProjects is null || _localProjects.Count == 0)
                {
                    <div class="empty-state local-empty-state">
                        <div class="empty-state-icon">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </div>
                        <h2>No deployable local projects found</h2>
                        <p class="page-description">AutoMate did not find Git repositories with C# projects under <strong>@_lastSearchedPath</strong>.</p>
                    </div>
                }
                else
                {
                    var totalProjects = _localProjects.Count;
                    var totalSubProjects = _localProjects.Sum(project => project.CsProjects.Count());
                    var totalWebProjects = _localProjects.Sum(project => project.CsProjects.Count(subProject => subProject.IsWebProject));

                    <section class="local-results-section" aria-labelledby="local-results-title">
                        <div class="section-heading">
                            <div>
                                <div class="panel-label">Scan results</div>
                                <h2 id="local-results-title">Projects found</h2>
                            </div>

                            <div class="local-result-summary" aria-label="Local scan summary">
                                <span class="local-summary-pill">
                                    <strong>@totalProjects</strong> repositories
                                </span>
                                <span class="local-summary-pill">
                                    <strong>@totalWebProjects</strong> web apps
                                </span>
                                <span class="local-summary-pill">
                                    <strong>@totalSubProjects</strong> subprojects
                                </span>
                            </div>
                        </div>

                        <div class="local-project-grid">
                            @foreach (var project in _localProjects)
                            {
                                var csProjects = project.CsProjects.ToList();
                                var webProjects = csProjects.Count(subProject => subProject.IsWebProject);

                                <article class="card resource-card local-project-card">
                                    <div class="local-project-header">
                                        <div class="local-project-title-group">
                                            <div class="local-project-mark">
                                                <i class="bi bi-folder-fill" aria-hidden="true"></i>
                                            </div>
                                            <div class="min-w-0">
                                                <h3 class="local-project-title text-truncate" title="@project.Name">@project.Name</h3>
                                                <div class="local-source-label">Local workspace</div>
                                            </div>
                                        </div>

                                        <span class="badge deployment-badge @(webProjects > 0 ? "deployment-badge-success" : "deployment-badge-neutral")">
                                            <i class="bi @(webProjects > 0 ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                                            @webProjects web
                                        </span>
                                    </div>

                                    <div class="local-project-path" title="@project.Path">
                                        <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                        <span class="text-truncate">@project.Path</span>
                                    </div>

                                    <div class="local-project-facts">
                                        <span class="local-fact">
                                            <i class="bi bi-diagram-3" aria-hidden="true"></i>
                                            <strong>@csProjects.Count</strong> subprojects
                                        </span>
                                        <span class="local-fact">
                                            <i class="bi bi-window" aria-hidden="true"></i>
                                            <strong>@webProjects</strong> web apps
                                        </span>
                                    </div>

                                    <div class="local-subproject-list">
                                        @if (csProjects.Count == 0)
                                        {
                                            <div class="local-subproject-empty">
                                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                                                No C# subprojects found in this repository.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var subProj in csProjects)
                                            {
                                                var isSaving = IsSaving(subProj);

                                                <div class="local-subproject-row @(subProj.IsWebProject ? "local-subproject-web" : "local-subproject-library")">
                                                    <div class="local-subproject-main">
                                                        <i class="bi bi-filetype-cs" aria-hidden="true"></i>
                                                        <div class="min-w-0">
                                                            <div class="local-subproject-name text-truncate" title="@subProj.Name">@subProj.Name</div>
                                                            <div class="local-subproject-path text-truncate" title="@subProj.Path">@subProj.Path</div>
                                                        </div>
                                                    </div>

                                                    <div class="local-subproject-actions">
                                                        <span class="badge deployment-badge @(subProj.IsWebProject ? "deployment-badge-success" : "deployment-badge-neutral")">
                                                            @(subProj.IsWebProject ? "Web app" : "Library")
                                                        </span>

                                                        @if (subProj.IsWebProject)
                                                        {
                                                            <button class="btn btn-sm btn-primary local-save-button"
                                                                    @onclick="() => SaveProjectAsync(project, subProj)"
                                                                    disabled="@isSaving">
                                                                @if (isSaving)
                                                                {
                                                                    <span class="spinner-border spinner-border-sm"
                                                                          role="status" aria-hidden="true"></span>
                                                                    <span>Saving...</span>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-cloud-download" aria-hidden="true"></i>
                                                                    <span>Save</span>
                                                                }
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            }
            else
            {
                <div class="empty-state local-empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-folder2-open" aria-hidden="true"></i>
                    </div>
                    <h2>Choose a folder to scan</h2>
                    <p class="page-description">AutoMate will look for Git repositories and supported C# web projects.</p>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <div class="auth-state">
                <div class="auth-state-icon">
                    <i class="bi bi-lock-fill" aria-hidden="true"></i>
                </div>
                <h2>Authentication required</h2>
                <p class="page-description">Please log in to scan your local folders for Git projects.</p>
                <a href="/login" class="btn btn-primary mt-2">Login</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
