<div class="modal fade show d-block" tabindex="-1"
     style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Configure Deployment: @Config.ProjectName</h5>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="OnCancel"></button>
            </div>

            <div class="modal-body p-4">
                <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">Basic Settings</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Environment</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="Config.EnvironmentName">
                            <option value="Development">Development</option>
                            <option value="Staging">Staging</option>
                            <option value="Production">Production</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Exposed Port (Host)</label>
                        <input type="number" class="form-control bg-dark text-light border-secondary"
                               @bind="Config.ExposedPort" placeholder="e.g., 8080"/>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-end mb-3 border-bottom pb-2">
                    <h6 class="text-primary fw-bold mb-0">Databases</h6>
                    <button type="button" class="btn btn-sm btn-success" @onclick="AddEmptyDatabase">
                        <i class="bi bi-plus-lg"></i> Add Database
                    </button>
                </div>

                @if (Config.Databases == null || !Config.Databases.Any())
                {
                    <p class="text-light small text-center my-3">No databases defined.</p>
                }
                else
                {
                    @foreach (var db in Config.Databases)
                    {
                        <div
                            class="bg-secondary bg-opacity-10 border border-secondary p-3 rounded-3 mb-3 position-relative">
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2"
                                    @onclick="@(() => RemoveDatabase(db))" title="Remove database">
                                <i class="bi bi-trash"></i> X
                            </button>

                            <div class="row g-3 mb-3 mt-1">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Database Engine</label>
                                    <select class="form-select bg-dark text-light border-secondary" @bind="db.DbType">
                                        <option value="PostgreSQL">PostgreSQL</option>
                                        <option value="MySQL">MySQL</option>
                                        <option value="SQLServer">Microsoft SQL Server</option>
                                        <option value="MongoDB">MongoDB</option>
                                        <option value="Redis">Redis</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Connection String Name</label>
                                    <input type="text" class="form-control bg-dark text-light border-secondary"
                                           @bind="db.ConnectionStringName" placeholder="e.g. DefaultConnection"/>
                                </div>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Database Name</label>
                                    <input type="text" class="form-control bg-dark text-light border-secondary"
                                           @bind="db.DbName" placeholder="mydb"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Username</label>
                                    <input type="text" class="form-control bg-dark text-light border-secondary"
                                           @bind="db.DbUser" placeholder="admin"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Password</label>
                                    <input type="text" class="form-control bg-dark text-light border-secondary"
                                           @bind="db.DbPassword" placeholder="secret"/>
                                </div>
                            </div>
                        </div>
                    }
                }

                <div class="d-flex justify-content-between align-items-end mb-3 mt-4 border-bottom pb-2">
                    <h6 class="text-primary fw-bold mb-0">Custom Environment Variables</h6>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                @onclick="LoadVariablesFromConfigFilesAsync">
                            <i class="bi bi-file-earmark-arrow-down"></i> Load Variables
                        </button>
                        <button type="button" class="btn btn-sm btn-success" @onclick="AddEmptyEnvVar">
                            <i class="bi bi-plus-lg"></i> Add
                        </button>
                    </div>
                </div>

                @if (!_envVars.Any())
                {
                    <p class="text-light small text-center my-3">No custom environment variables defined.</p>
                }
                else
                {
                    @foreach (var item in _envVars)
                    {
                        <div class="row g-2 mb-2 align-items-center">
                            <div class="col-5">
                                <input type="text"
                                       class="form-control font-monospace bg-dark text-light border-secondary"
                                       placeholder="KEY (e.g. API_TOKEN)" @bind="item.Key"/>
                            </div>
                            <div class="col-6">
                                <input type="text"
                                       class="form-control font-monospace bg-dark text-light border-secondary"
                                       placeholder="Value" @bind="item.Value"/>
                            </div>
                            <div class="col-1 text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="@(() => RemoveEnvVar(item))" title="Remove variable">
                                    <i class="bi bi-trash"></i> X
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ConfirmDeploy">
                    <i class="bi bi-rocket-takeoff me-1"></i> Start Deployment
                </button>
            </div>
        </div>
    </div>
</div>