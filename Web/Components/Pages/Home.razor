@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<h1>Welcome to AutoMate!</h1>

<AuthorizeView>
    <Authorized>
        <div class="alert alert-success mt-4">
            Successful login! Welcome, <strong>@context.User.Identity?.Name</strong>!
        </div>
    </Authorized>

    <NotAuthorized>
        <h3 class="mt-4">Your favorite tool for deployment automation!</h3>
        <h4>Write the code, we will take care of the rest.</h4>
        <p class="mt-4">
            AutoMate can manage the DevOps lifecycle of your applications, from build to deployment and monitoring.
            With AutoMate, you can easily:
        </p>
        <ul>
            <li>set up pipelines</li>
            <li>automate tasks</li>
            <li>manage builds</li>
            <li>CI/CD</li>
        </ul>
    </NotAuthorized>
</AuthorizeView>