@page "/project/{ProjectId:guid}/deployment/{DeploymentId:guid}"
@attribute [Authorize]
@using Application.Abstractions.Diagnostics
@using Application.Data.Apps
@using Application.Data.Users
@using Domain.Entities
@using Domain.Enums
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@inject AuthenticationStateProvider Authentication
@inject IUserService Users
@inject IServiceScopeFactory ServiceScopes
@inject ILogger<DeploymentHistory> Logger

<PageTitle>Deployment Details</PageTitle>
<main class="history-page">
    <header class="history-header">
        <a href="@($"/project/{ProjectId}")">← Back to project</a>
        <div class="telemetry-toolbar">
            <div><p class="telemetry-eyebrow">DEPLOYMENT</p>
                <h1>Deployment Details</h1></div>
            <span class="history-id">@DeploymentId.ToString("N")[..8]</span></div>
        <details class="history-identity">
            <summary>Deployment details</summary>
            <p>Deployment ID: <code>@DeploymentId</code></p></details>
    </header>
    @if (_error is not null)
    {
        <p class="telemetry-notice" role="alert">@_error</p>
    }
    @if (_authorized)
    {
        <section class="telemetry-panel">
            <h2>Deployment overview</h2>
            @if (_deployment is not null)
            {
                <DeploymentBadge Status="_deployment.Status"/>
                <p>@(_deployment.CsProject?.Name) · Started @_deployment.CreatedAt.ToString("u") ·
                    Outcome @_deployment.Outcome</p>
                <p>Finished: @(_deployment.FinishedAt?.ToString("u") ?? "Not recorded")</p>
            }
        </section>
        <section class="telemetry-panel" aria-labelledby="history-logs-title">
            <div class="telemetry-toolbar">
                <div><h2 id="history-logs-title">Logs</h2>
                    <p class="telemetry-muted">Saved build and runtime output</p></div>
            </div>
            @if (_history?.Availability is { } availability)
            {
                <p class="telemetry-notice" role="status">@availability</p>
            }
            <div class="history-log-controls">
                <div class="history-search"><label for="history-search">Search saved logs</label>
                    <div class="d-flex gap-2"><input id="history-search" class="form-control" maxlength="256"
                                                     @bind="_search"/>
                        <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="LatestAsync">Search
                        </button>
                    </div>
                </div>
                <label class="telemetry-control">Channel<select class="form-select" @bind="_channel"
                                                                @bind:after="RenderTerminalAsync">@foreach (var channel in _history?.Events.Select(e => e.TerminalChannel).Distinct() ?? [])
                        {
                            <option value="@channel">@channel</option>
                        }</select></label>
            </div>
            <div class="history-terminal-viewport">
                <Terminal @ref="_terminal" OnReady="RenderTerminalAsync"/>
            </div>
            <div class="history-log-footer"><span class="telemetry-muted">Bounded saved output</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" disabled="@(_busy || _history?.EarlierOmitted != true)"
                            @onclick="EarlierAsync">Earlier output
                    </button>
                    <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="LatestAsync">Latest output
                    </button>
                </div>
            </div>
        </section>
        <section class="telemetry-panel" aria-labelledby="history-metrics-title" aria-busy="@_metricBusy">
            <div class="telemetry-toolbar">
                <div><h2 id="history-metrics-title">Resource overview</h2>
                    <p class="telemetry-muted">Summaries of returned interval aggregates</p></div>
                <div class="telemetry-controls">
                    <label class="telemetry-control">Period<select class="form-select" @bind="_metricDays"
                                                                   @bind:after="LoadMetricsAsync">
                            <option value="1">24 hours</option>
                            <option value="7">7 days</option>
                            <option value="30">30 days</option>
                            <option value="0">Deployment lifetime</option>
                        </select></label>
                    <label class="telemetry-control">Container<select class="form-select" @bind="_metricContainer"
                                                                      disabled="@(_metrics.Count == 0)">
                            @foreach (var name in _metrics.Select(p => p.Container).Distinct().Order())
                            {
                                <option value="@name">@name</option>
                            }
                        </select></label>
                </div>
            </div>
            @if (_metricBusy)
            {
                <p class="telemetry-muted" role="status">Loading metrics…</p>
            }
            <div class="telemetry-kpis">
                <div class="telemetry-kpi">
                    <span>Average CPU</span><strong>@Value(TelemetryPresentation.Cpu, false)</strong><small>Observed
                        intervals</small></div>
                <div class="telemetry-kpi"><span>Peak CPU</span><strong>@Value(TelemetryPresentation.Cpu, true)</strong><small>Observed
                        maximum</small></div>
                <div class="telemetry-kpi">
                    <span>Average memory</span><strong>@Value(TelemetryPresentation.Memory, false)</strong><small>Observed
                        intervals</small></div>
                <div class="telemetry-kpi">
                    <span>Peak memory</span><strong>@Value(TelemetryPresentation.Memory, true)</strong><small>Observed
                        maximum</small></div>
            </div>
            <div class="telemetry-support">
                @if (Selected(TelemetryPresentation.MemoryLimit).LastOrDefault() is { } limit)
                {
                    <span>Latest observed memory limit: <strong>@TelemetryPresentation.Format(limit.Average, limit.Name)</strong></span>
                }
                <span>Missing intervals remain gaps · saved history retained until deletion</span>
            </div>
            @if (_metricAvailability is not null)
            {
                <p class="telemetry-notice" role="status">@_metricAvailability</p>
            }
            @if (_metrics.Count == 0)
            {
                <p class="telemetry-muted">No saved metric observations in this period. Runtime collection is
                    optional.</p>
            }
            <details class="telemetry-explore">
                <summary>Explore metrics <span>CPU, memory and numeric observations</span></summary>
                <div class="telemetry-chart-grid">
                    <TelemetryChart Title="CPU usage" Metric="@TelemetryPresentation.Cpu"
                                    Points="@ChartPoints(TelemetryPresentation.Cpu)"
                                    Start="_metricStart" End="_end" Gap="@ChartGap"/>
                    <TelemetryChart Title="Memory usage" Metric="@TelemetryPresentation.Memory"
                                    Points="@ChartPoints(TelemetryPresentation.Memory)"
                                    Start="_metricStart" End="_end" Gap="@ChartGap"/>
                </div>
                <details class="telemetry-table-details">
                    <summary>Numeric observations</summary>
                    <div class="table-responsive">
                        <table class="table telemetry-table">
                            <caption>Returned interval aggregates for @_metricContainer. Sample counts are not supplied
                                by this history query.
                            </caption>
                            <thead>
                            <tr>
                                <th>UTC</th>
                                <th>Metric</th>
                                <th>Average</th>
                                <th>Minimum</th>
                                <th>Maximum</th>
                            </tr>
                            </thead>
                            <tbody>@foreach (var point in _metrics.Where(p => p.Container == _metricContainer).OrderBy(p => p.Timestamp).ThenBy(p => p.Name))
                            {
                                <tr>
                                    <td>@point.Timestamp.ToString("u")</td>
                                    <td><span title="@point.Name">@TelemetryPresentation.Label(point.Name)</span></td>
                                    <td>@TelemetryPresentation.Format(point.Average, point.Name)</td>
                                    <td>@TelemetryPresentation.Format(point.Minimum, point.Name)</td>
                                    <td>@TelemetryPresentation.Format(point.Maximum, point.Name)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </details>
            </details>
        </section>
        <section class="telemetry-panel"><h2>Collection settings</h2>
            <TelemetryPreferences ProjectId="ProjectId"/>
        </section>
        <section class="telemetry-panel">
            <h2>AI Analysis</h2>
            <DeploymentAnalysisSection @key="DeploymentId" OwnerId="_owner" ProjectId="ProjectId"
                                       DeploymentId="DeploymentId"
                                       CsProjectId="@(_deployment?.CsProjectId ?? Guid.Empty)"
                                       Consented="_aiConsented"/>
        </section>
        <section class="telemetry-panel">
            <h2>Recorded configuration and provider details</h2>
            <DeploymentConfigurationDetails Deployment="_deployment"/>
        </section>
    }
</main>

@code {

    /// <summary>Authorized project identity.</summary>
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>Selected historical run identity.</summary>
    [Parameter]
    public Guid DeploymentId { get; set; }

    /// <summary>Internal owner identity.</summary>
    private Guid _owner;

    /// <summary>Server-authorized page state.</summary>
    private bool _authorized;

    /// <summary>Suppresses overlapping history reads.</summary>
    private bool _busy;

    /// <summary>Bounded current output page.</summary>
    private DeploymentTerminalHistory? _history;

    private string? _earlierCursor;
    private string _search = "";

    /// <summary>Bounded metric aggregates.</summary>
    private IReadOnlyList<DeploymentMetricPoint> _metrics = [];

    /// <summary>Distinguishes missing data from unavailable or truncated history.</summary>
    private string? _metricAvailability;

    /// <summary>Selected original terminal channel.</summary>
    private string _channel = "";

    /// <summary>Terminal presentation sink.</summary>
    private Terminal? _terminal;

    /// <summary>Safe history failure message.</summary>
    private string? _error;

    /// <summary>Fixed chart time range.</summary>
    private DateTimeOffset _end = DateTimeOffset.UtcNow;

    /// <summary>Recorded deployment beginning, independent of the current date.</summary>
    private DateTimeOffset _start = DateTimeOffset.UtcNow.AddDays(-30);

    /// <summary>Owner-authorized metadata for this exact history route.</summary>
    private Deployment? _deployment;

    /// <summary>Current exact-project egress consent; historical settings do not grant consent.</summary>
    private bool _aiConsented;

    /// <summary>Displayed metric range beginning.</summary>
    private DateTimeOffset _metricStart = DateTimeOffset.UtcNow.AddDays(-30);

    /// <summary>Includes retained older deployments by default, with bounded zoom choices.</summary>
    private int _metricDays;

    /// <summary>Range belonging to the displayed response while a newer range is loading.</summary>
    private int _loadedMetricDays = 30;

    /// <summary>Selected container, shared by all metric summaries and charts.</summary>
    private string _metricContainer = "";

    /// <summary>Independent metric request state; log paging never resets it.</summary>
    private bool _metricBusy;

    /// <summary>Cancels previous range requests and all requests on navigation.</summary>
    private readonly CancellationTokenSource _lifetime = new();

    /// <summary>The current range request identity.</summary>
    private CancellationTokenSource? _metricLoad;

    /// <summary>The active log request, independent of metrics.</summary>
    private CancellationTokenSource? _logLoad;

    /// <summary>Gap threshold consistent with the bounded history query interval.</summary>
    private TimeSpan ChartGap => TimeSpan.FromSeconds(Math.Max(60, (_end - _metricStart).TotalSeconds / 120d) + 5);

    /// <summary>Orders the selected container's observations for a metric.</summary>
    private IEnumerable<DeploymentMetricPoint> Selected(string name)
    {
        return _metrics.Where(p => p.Container == _metricContainer && p.Name == name).OrderBy(p => p.Timestamp);
    }

    /// <summary>Shows interval means or extrema, without claiming raw sample weighting.</summary>
    private string Value(string metric, bool peak)
    {
        var points = Selected(metric).ToArray();
        return TelemetryPresentation.Format(points.Length == 0 ? null : peak ? points.Max(p => p.Maximum) : points.Average(p => p.Average), metric);
    }

    /// <summary>Adapts existing aggregates to the reusable presentation component.</summary>
    private IReadOnlyList<TelemetryChartPoint> ChartPoints(string metric)
    {
        return Selected(metric).Select(p => new TelemetryChartPoint(p.Timestamp, p.Average, p.Minimum, p.Maximum)).ToArray();
    }

    /// <summary>Preserves the selected page/channel across unchanged route parameters.</summary>
    private (Guid Project, Guid Deployment)? _loadedRoute;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedRoute == (ProjectId, DeploymentId)) return;
        var selection = (ProjectId, DeploymentId);
        _loadedRoute = selection;
        _history = null;
        _logLoad?.Cancel();
        _metricLoad?.Cancel();
        _metrics = [];
        _channel = "";
        _authorized = false;
        var owner = await AuthenticatedUserResolver.GetCurrentUserIdAsync(Authentication, Users);
        if (selection != (ProjectId, DeploymentId) || _lifetime.IsCancellationRequested) return;
        _owner = owner;
        _deployment = null;
        _aiConsented = false;
        await using (var scope = ServiceScopes.CreateAsyncScope())
        {
            var details = scope.ServiceProvider.GetService<IDeploymentDetailsService>();
            var deployment = details is null ? null : await details.GetAsync(owner, selection.ProjectId, selection.DeploymentId, _lifetime.Token);
            if (selection != (ProjectId, DeploymentId) || _lifetime.IsCancellationRequested) return;
            _deployment = deployment;
            if (_deployment is not null)
            {
                _start = _deployment.CreatedAt;
                _end = _deployment.Status == DeploymentStatus.Running ? DateTimeOffset.UtcNow : _deployment.UpdatedAt;
                if (_end <= _start) _end = _start.AddMinutes(1);
                var app = await scope.ServiceProvider.GetRequiredService<IApplicationService>().GetAppByIdAsync(ProjectId, _owner, _lifetime.Token);
                if (selection != (ProjectId, DeploymentId) || _lifetime.IsCancellationRequested) return;
                _aiConsented = app?.CsProjects.FirstOrDefault(p => p.Id == _deployment.CsProjectId)?.Configuration?.AiDiagnosticEgressConsented == true;
            }
        }

        await LoadAsync(null);
        if (_authorized) await LoadMetricsAsync();
    }

    /// <summary>Requests the preceding cursor page without accumulating unbounded terminal memory.</summary>
    private Task EarlierAsync()
    {
        return LoadAsync(_earlierCursor);
    }

    /// <summary>Returns to the most recent page.</summary>
    private Task LatestAsync()
    {
        return LoadAsync(null);
    }

    /// <summary>Loads authorized bounded output and metric history.</summary>
    private async Task LoadAsync(string? cursor)
    {
        _logLoad?.Cancel();
        using var request = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _logLoad = request;
        _busy = true;
        try
        {
            var route = (ProjectId, DeploymentId);
            await using var scope = ServiceScopes.CreateAsyncScope();
            var service = scope.ServiceProvider.GetRequiredService<IDeploymentHistoryService>();
            var page = await service.ReadLogsV2Async(_owner, ProjectId, DeploymentId, cursor, true, 500, _search, request.Token);
            if (route != (ProjectId, DeploymentId) || request.IsCancellationRequested) return;
            _earlierCursor = page.EarlierCursor;
            _history = new DeploymentTerminalHistory(page.Events, page.EarlierCursor is not null, page.Availability, page.CanAdvanceCursor);
            _authorized = true;
            _channel = _history.Events.Any(e => e.TerminalChannel == _channel) ? _channel : _history.Events.FirstOrDefault()?.TerminalChannel ?? "";
            _error = null;
            await RenderTerminalAsync();
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested)
        {
        }
        catch (UnauthorizedAccessException)
        {
            if (request.IsCancellationRequested) return;
            _authorized = false;
            _error = "Deployment history access denied.";
        }
        catch (Exception ex)
        {
            if (request.IsCancellationRequested) return;
            Logger.LogWarning("Deployment history unavailable: {FailureType}.", ex.GetType().Name);
            _error = "Some deployment history is temporarily unavailable.";
        }
        finally
        {
            if (ReferenceEquals(_logLoad, request))
            {
                _busy = false;
                _logLoad = null;
            }
        }
    }

    /// <summary>Restores the selected channel into xterm after its initialization.</summary>
    private async Task RenderTerminalAsync()
    {
        if (_terminal is null || _history is null) return;
        await _terminal.ClearAsync();
        var output = string.Concat(_history.Events.Where(e => e.TerminalChannel == _channel).Select(DeploymentTerminalPresentation.Format));
        await _terminal.WriteAsync(output.Length > 0 ? output : "[No saved output in this terminal page.]\r\n");
    }

    /// <summary>Loads a cancellable metric range without reading or clearing saved terminal output.</summary>
    private async Task LoadMetricsAsync()
    {
        _metricLoad?.Cancel();
        using var request = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _metricLoad = request;
        _metricBusy = true;
        var route = (ProjectId, DeploymentId);
        var days = _metricDays;
        try
        {
            await using var scope = ServiceScopes.CreateAsyncScope();
            var service = scope.ServiceProvider.GetRequiredService<IDeploymentHistoryService>();
            var rangeStart = days == 0 ? _start : _end.AddDays(-days);
            var result = await service.ReadMetricsAsync(_owner, route.ProjectId, route.DeploymentId, rangeStart, _end, 120, request.Token);
            if (request.IsCancellationRequested || route != (ProjectId, DeploymentId)) return;
            _metrics = result.Points;
            _loadedMetricDays = days;
            _metricStart = rangeStart;
            _metricAvailability = result.Availability;
            if (!_metrics.Any(p => p.Container == _metricContainer))
                _metricContainer = _metrics.Select(p => p.Container).Distinct().Order().FirstOrDefault() ?? "";
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested)
        {
        }
        catch (UnauthorizedAccessException)
        {
            if (request.IsCancellationRequested) return;
            _authorized = false;
            _metrics = [];
            _error = "Deployment history access denied.";
        }
        catch (Exception ex)
        {
            if (request.IsCancellationRequested) return;
            Logger.LogWarning("Metric history unavailable: {FailureType}.", ex.GetType().Name);
            _metrics = [];
            _metricAvailability = "Metric history is temporarily unavailable. Saved terminal output remains available.";
        }
        finally
        {
            if (ReferenceEquals(_metricLoad, request))
            {
                _metricBusy = false;
                _metricLoad = null;
            }
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

}
