@page "/dashboard"
@using Core.Enums

<PageTitle>Dashboard</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Dashboard</h1>
    </div>

    @if (!string.IsNullOrEmpty(_globalErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_globalErrorMessage
            <button type="button" class="btn-close" @onclick="() => _globalErrorMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_globalSuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @_globalSuccessMessage
            <button type="button" class="btn-close" @onclick="() => _globalSuccessMessage = null"></button>
        </div>
    }

    <AuthorizeView>
        <Authorized>
            @if (_isLoading)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (_projects == null || !_projects.Any())
            {
                <div class="text-center mt-5 text-muted bg-light p-5 rounded-3 border border-dashed">
                    <i class="bi bi-rocket-takeoff display-1 text-secondary opacity-50"></i>
                    <h3 class="mt-4">No projects were saved yet.</h3>
                    <p class="lead">Start building your own DevOps environment!</p>
                    <div class="mt-4">
                        <a href="/local-repos" class="btn btn-outline-primary mx-2">Search Locally</a>
                        <a href="/github-repos" class="btn btn-outline-dark mx-2">Get GitHub Repositories</a>
                    </div>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var project in _projects)
                    {
                        <div class="col">
                            <div class="card h-100 shadow border-black border-1">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title fw-bold text-truncate mb-0" title="@project.Name">
                                            @if (project.SourceType == SourceType.Remote)
                                            {
                                                <i class="bi bi-github me-2"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-folder2-open me-2 text-warning"></i>
                                            }
                                            @project.Name
                                        </h5>

                                        <span class="badge rounded-pill bg-light text-dark border"><i
                                                class="bi bi-circle-fill text-secondary small me-1"></i> Not Deployed</span>
                                    </div>

                                    <p class="text-muted small text-truncate mt-3 mb-1"
                                       title="@project.SourcePathOrUrl">
                                        <i class="bi bi-link-45deg"></i> @project.SourcePathOrUrl
                                    </p>
                                </div>
                                <div class="card-footer bg-transparent border-top-0 pt-0 d-flex gap-2">

                                    <button class="btn btn-success flex-grow-1"
                                            @onclick="() => DeployProjectAsync(project)"
                                            disabled="@IsDeploying(project.Id)">
                                        @if (IsDeploying(project.Id))
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"
                                                  aria-hidden="true"></span>
                                            <span>Deploying...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-play-fill me-1"></i>
                                            <span>Deploy</span>
                                        }
                                    </button>

                                    <button class="btn btn-outline-danger" @onclick="() => DeleteProject(project.Id)"
                                            title="Remove project" disabled="@IsDeploying(project.Id)">
                                        <i class="bi bi-trash3">Remove</i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    @if (_showConfigModal && _currentDeployConfig != null && _selectedProjectPath != null)
                    {
                        <ConfigurationForm
                            Config="@_currentDeployConfig"
                            ProjectPath="@_selectedProjectPath"
                            OnCancel="@CancelDeployment"
                            OnDeployConfirmed="@ExecuteDeploymentAsync"
                        />
                    }
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning">
                Log in to see your projects!
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>