@page "/dashboard"
@using Core.Enums

<PageTitle>Dashboard</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Dashboard</h1>
    </div>

    @if (!string.IsNullOrEmpty(_globalErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @_globalErrorMessage
            <button type="button" class="btn-close" @onclick="ClearMessages" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_globalSuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @_globalSuccessMessage
            <button type="button" class="btn-close" @onclick="ClearMessages" aria-label="Close"></button>
        </div>
    }

    <AuthorizeView>
        <Authorized>
            @if (_isLoading)
            {
                <div class="d-flex flex-column align-items-center justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                    <p class="mt-3 text-muted">Loading your workspace...</p>
                </div>
            }
            else if (_projects == null || !_projects.Any())
            {
                <div class="text-center mt-5 text-muted bg-light p-5 rounded-3 border border-dashed shadow-sm">
                    <i class="bi bi-rocket-takeoff display-1 text-secondary opacity-50"></i>
                    <h3 class="mt-4">No projects saved yet.</h3>
                    <p class="lead">Start building your own DevOps environment!</p>
                    <div class="mt-4 d-flex justify-content-center gap-3">
                        <a href="/local-repos" class="btn btn-outline-primary">
                            <i class="bi bi-folder2-open me-1"></i> Search Locally
                        </a>
                        <a href="/github-repos" class="btn btn-outline-dark">
                            <i class="bi bi-github me-1"></i> Get GitHub Repositories
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var project in _projects)
                    {
                        var isDeploying = IsDeploying(project.Id);

                        <div class="col">
                            <div class="card h-100 shadow border-2">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title fw-bold text-truncate mb-0" title="@project.Name">
                                            @if (project.SourceType == SourceType.Remote)
                                            {
                                                <i class="bi bi-github me-2"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-folder2-open me-2 text-warning"></i>
                                            }
                                            @project.Name
                                        </h5>

                                        @if (project.SourceType == SourceType.Local)
                                        {
                                            <span class="badge rounded-pill bg-light text-dark border">
                                                <i class="bi bi-circle-fill text-secondary small me-1"></i> Not Deployed
                                            </span>
                                        }
                                    </div>

                                    <p class="text-muted small text-truncate mt-3 mb-4"
                                       title="@project.SourcePathOrUrl">
                                        <i class="bi bi-link-45deg me-1"></i> @project.SourcePathOrUrl
                                    </p>

                                    <!-- mt-auto letolja a gombokat az aljára -->
                                    <div class="mt-auto d-flex gap-2">
                                        <button class="btn btn-success flex-grow-1"
                                                @onclick="() => DeployProjectAsync(project)"
                                                disabled="@isDeploying">
                                            @if (isDeploying)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status"
                                                      aria-hidden="true"></span>
                                                <span>Deploying...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-play-fill me-1"></i>
                                                <span>Deploy</span>
                                            }
                                        </button>

                                        <button class="btn btn-outline-danger"
                                                @onclick="() => DeleteProjectAsync(project.Id)"
                                                title="Remove project"
                                                disabled="@isDeploying">
                                            <i class="bi bi-trash3"></i> Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_showConfigModal && _currentDeployConfig != null && _selectedProjectPath != null)
                    {
                        <ConfigurationForm
                            Config="@_currentDeployConfig"
                            ProjectPath="@_selectedProjectPath"
                            OnCancel="@HideConfigModal"
                            OnDeployConfirmed="@ExecuteDeploymentAsync"/>
                    }
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <div class="text-center mt-5">
                <i class="bi bi-lock-fill display-1 text-muted mb-3"></i>
                <h3>Authentication Required</h3>
                <p class="text-muted">Please log in to view your dashboard.</p>
                <a href="/login" class="btn btn-primary mt-2">Login</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>