@using Web.Components.Pages.Errors
@*
    Resolves routed components and applies the application layout and authorization views.
*@
<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(NotFound)">
        <Found Context="routeData">
            <RouteView @key="RouteKey(routeData)" RouteData="routeData" DefaultLayout="typeof(MainLayout)"/>
            <FocusOnNavigate RouteData="routeData" Selector="h1"/>
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {

    /// <summary>
    ///     Dispose deployment presenters and scroll listeners when the selected project or deployment
    ///     changes.
    /// </summary>
    /// <param name="data">Current route component and parameters.</param>
    /// <returns>The routed component type name combined with its project parameter when present.</returns>
    private static string RouteKey(RouteData data)
    {
        return data.PageType.FullName + ":" +
               string.Join(":", data.RouteValues.OrderBy(value => value.Key).Select(value => value.Value));
    }

}
