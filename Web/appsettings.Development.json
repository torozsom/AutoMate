{
  "TelemetryStorage": {
    "Backend": "LokiMimir",
    "DeliveryMode": "DiskGateway",
    "GatewayUrl": "http://localhost:9450",
    "AllowInsecureDevelopment": true,
    "LokiUrl": "https://localhost:9443/loki",
    "MetricsWriteUrl": "https://localhost:9443/mimir/otlp/v1/metrics",
    "MetricsQueryUrl": "https://localhost:9443/mimir/prometheus"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient.DeploymentTelemetry": "Warning"
    }
  }
}
