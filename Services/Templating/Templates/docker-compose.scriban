services:
  web:
    container_name: {{ project_name | string.downcase }}-web
    build:
      context: ..
      dockerfile: .automate/Dockerfile
    ports:
      - "{{ exposed_port }}:8080"
    environment:
      - ASPNETCORE_ENVIRONMENT={{ environment_name }}

      {{- if requires_db }}
      # --- Automatically generated connection strings for the databases ---
      {{- for db in databases }}
      {{- if db.type == 'PostgreSQL' }}
      - ConnectionStrings__{{ db.conn_name }}=Host={{ app_name | string.downcase }}-{{ db.container_suffix }};Port=5432;Database={{ db.name }};Username={{ db.user }};Password={{ db.password }}
      {{- else if db.type == 'MySQL' }}
      - ConnectionStrings__{{ db.conn_name }}=Server={{ app_name | string.downcase }}-{{ db.container_suffix }};Port=3306;Database={{ db.name }};Uid={{ db.user }};Pwd={{ db.password }}
      {{- else if db.type == 'SQLServer' }}
      - ConnectionStrings__{{ db.conn_name }}=Server={{ app_name | string.downcase }}-{{ db.container_suffix }},1433;Database={{ db.name }};User Id={{ db.user }};Password={{ db.password }};TrustServerCertificate=True
      {{- else if db.type == 'MongoDB' }}
      - ConnectionStrings__{{ db.conn_name }}=mongodb://{{ db.user_encoded }}:{{ db.password_encoded }}@{{ app_name | string.downcase }}-{{ db.container_suffix }}:27017/{{ db.name }}?authSource=admin
      {{- else if db.type == 'Redis' }}
      - ConnectionStrings__{{ db.conn_name }}={{ app_name | string.downcase }}-{{ db.container_suffix }}:6379{{ if db.password != "" }},password={{ db.password }}{{ end }}
      {{- end }}
      {{- end }}
      {{- end }}

      # --- User defined environmental variables ---
      {{- for env_var in custom_env_vars }}
      - {{ env_var.key }}={{ env_var.value }}
      {{- end }}

    {{- if requires_db }}
    depends_on:
      {{- for db in databases }}
      - {{ app_name | string.downcase }}-{{ db.container_suffix }}
      {{- end }}
    {{- end }}

{{ if requires_db }}
  {{- for db in databases }}
  {{ app_name | string.downcase }}-{{ db.container_suffix }}:
    container_name: {{ app_name | string.downcase }}-{{ db.container_suffix }}
    {{- if db.type == 'PostgreSQL' }}
    image: postgres:15-alpine
    environment:
      - POSTGRES_USER={{ db.user }}
      - POSTGRES_PASSWORD={{ db.password }}
      - POSTGRES_DB={{ db.name }}
    ports:
      - "5432"

    {{- else if db.type == 'MySQL' }}
    image: mysql:8.0
    environment:
      - MYSQL_ROOT_PASSWORD={{ db.password }}
      - MYSQL_DATABASE={{ db.name }}
      - MYSQL_USER={{ db.user }}
      - MYSQL_PASSWORD={{ db_password }}
    ports:
      - "3306"

    {{- else if db.type == 'SQLServer' }}
    image: mcr.microsoft.com/mssql/server:2022-latest
    environment:
      - ACCEPT_EULA=Y
      - MSSQL_SA_PASSWORD={{ db.password }}
    ports:
      - "1433"

    {{- else if db.type == 'MongoDB' }}
    image: mongo:latest
    environment:
      - MONGO_INITDB_ROOT_USERNAME={{ db.user }}
      - MONGO_INITDB_ROOT_PASSWORD={{ db.password }}
      - MONGO_INITDB_DATABASE={{ db.name }}
    ports:
      - "27017"

    {{- else if db.type == 'Redis' }}
    image: redis:7-alpine
    {{- if db.password != "" }}
    command: redis-server --requirepass {{ db.password }}
    {{- end }}
    ports:
      - "6379"
    {{- end }}
  {{- end }}
{{ end }}