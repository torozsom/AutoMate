<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>Test</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Application/Application.csproj"/>
        <ProjectReference Include="../Domain/Domain.csproj"/>
        <ProjectReference Include="../Infrastructure/Infrastructure.csproj"/>
        <ProjectReference Include="../Web/Web.csproj"/>
        <ProjectReference Include="../Telemetry/Telemetry.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="EFCore.NamingConventions" Version="10.0.1"/>
        <PackageReference Include="FluentAssertions" Version="8.11.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14"/>
    </ItemGroup>
</Project>
